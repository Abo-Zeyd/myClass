      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#fff9ed] font-['Noto_Sans_Arabic',sans-serif] text-[#432818]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\">\n    <header class=\"border-b border-[#ead9b5] bg-[#fffdf8]\" data-kid=\"1-1\" data-name=\"page header\">\n        <div class=\"mx-auto flex h-[78px] max-w-[1120px] items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"branding and info group\">\n                <div class=\"flex size-11 items-center justify-center rounded-xl bg-[#6f1d1b] text-white\" data-kid=\"1-1-1-1-1\" data-name=\"graduation icon container\">\n                    <i aria-hidden=\"true\" class=\"icon-graduation-cap text-[22px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"department and professor info\">\n                    <div class=\"text-[18px] font-extrabold leading-6 text-[#6f1d1b]\" data-kid=\"1-1-1-1-2-1\" data-name=\"department name\">\n                        قسم السنة الرابعة\n                    </div>\n                    <div class=\"mt-0.5 text-[13px] font-medium text-[#765f4e]\" data-kid=\"1-1-1-1-2-2\" data-name=\"professor name\">\n                        الأستاذ: عز الدين عويسي\n                    </div>\n                </div>\n            </div>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"flex items-center gap-2 text-[14px] font-bold\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-[#432818] hover:bg-[#f7f0e0]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link home\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"icon-house text-[18px] text-[#6f1d1b]\" data-kid=\"1-1-1-2-1-1\" data-name=\"house icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"home link text\">\n                        الرئيسية\n                    </span>\n                </a>\n                <a class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-[#432818] hover:bg-[#f7f0e0]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link lessons\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"icon-book-open text-[18px] text-[#6f1d1b]\" data-kid=\"1-1-1-2-2-1\" data-name=\"book open icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"lessons link text\">\n                        الدروس\n                    </span>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto grid min-h-[calc(100vh-78px)] max-w-[1120px] items-center gap-12 px-6 py-12 lg:grid-cols-[1fr_0.92fr] lg:gap-20\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section class=\"max-w-[500px] py-4\" data-kid=\"1-2-1\" data-name=\"introductory section\">\n            <div class=\"mb-8 h-px w-16 bg-[#bb9457]\" data-kid=\"1-2-1-1\" data-name=\"decorative divider line\">\n            </div>\n            <h1 class=\"max-w-[460px] text-[38px] font-extrabold leading-[1.35] tracking-[-0.04em] text-[#6f1d1b] sm:text-[46px]\" data-kid=\"1-2-1-2\" data-name=\"hero section heading\">\n                إدارة محتوى\n                <br data-kid=\"1-2-1-2-1\" data-name=\"line break\"/>\n                قسم السنة الرابعة\n            </h1>\n            <p class=\"mt-5 max-w-[410px] text-[18px] leading-9 text-[#765f4e]\" data-kid=\"1-2-1-3\" data-name=\"hero section description\">\n                إدارة الواجبات ومحتوى الدروس\n            </p>\n            <div class=\"mt-10 border-t border-[#ead9b5] pt-6\" data-kid=\"1-2-1-4\" data-name=\"login information box\">\n                <p class=\"text-[14px] font-semibold text-[#765f4e]\" data-kid=\"1-2-1-4-1\" data-name=\"login section title\">\n                    تسجيل الدخول إلى لوحة الإدارة\n                </p>\n                <p class=\"mt-2 text-[14px] leading-7 text-[#765f4e]\" data-kid=\"1-2-1-4-2\" data-name=\"login section description\">\n                    لإدارة محتوى القسم التعليمي.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"login-heading\" class=\"w-full max-w-[490px] justify-self-center rounded-2xl border border-[#ead9b5] bg-[#fffdf8] p-7 shadow-[0_12px_36px_rgba(67,40,24,0.07)] sm:p-10\" data-kid=\"1-2-2\" data-name=\"login form card section\">\n            <div class=\"mb-8\" data-kid=\"1-2-2-1\" data-name=\"form header area\">\n                <p class=\"mb-2 text-[14px] font-bold text-[#99582a]\" data-kid=\"1-2-2-1-1\" data-name=\"card title label\">\n                    لوحة الإدارة\n                </p>\n                <h2 class=\"text-[26px] font-extrabold leading-tight text-[#432818] sm:text-[30px]\" data-kid=\"1-2-2-1-2\" data-name=\"login heading\" id=\"login-heading\">\n                    دخول لوحة الإدارة\n                </h2>\n                <p class=\"mt-3 text-[15px] leading-7 text-[#765f4e]\" data-kid=\"1-2-2-1-3\" data-name=\"login description\">\n                    إدارة الواجبات ومحتوى الدروس\n                </p>\n            </div>\n            <form class=\"grid gap-5\" data-kid=\"1-2-2-2\" data-name=\"login form\">\n                <div class=\"flex items-start gap-3 rounded-lg border border-[#b23a32]/25 bg-[#fcf0ed] px-4 py-3.5 text-[14px] font-semibold leading-6 text-[#8a241e]\" data-kid=\"1-2-2-2-1\" data-name=\"error message alert container\" role=\"alert\">\n                    <i aria-hidden=\"true\" class=\"icon-circle-alert mt-0.5 text-[18px]\" data-kid=\"1-2-2-2-1-1\" data-name=\"alert icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-1-2\" data-name=\"error message text\">\n                        كلمة المرور غير صحيحة.\n                    </span>\n                </div>\n                <label class=\"grid gap-2 text-[15px] font-bold text-[#432818]\" data-kid=\"1-2-2-2-2\" data-name=\"password input label\" for=\"password\">\n                    كلمة المرور\n                    <input autocomplete=\"current-password\" class=\"min-h-[52px] rounded-lg border border-[#d8c9a8] bg-[#fffaf0] px-4 text-[16px] text-[#432818] outline-none focus:border-[#6f1d1b] focus:ring-4 focus:ring-[#6f1d1b]/10\" data-kid=\"1-2-2-2-2-1\" data-name=\"password input field\" id=\"password\" name=\"password\" type=\"password\"/>\n                </label>\n                <button class=\"mt-1 inline-flex min-h-[52px] w-full items-center justify-center gap-2 rounded-lg bg-[#6f1d1b] px-5 text-[16px] font-bold text-white shadow-sm hover:bg-[#571715] focus:outline-none focus:ring-4 focus:ring-[#6f1d1b]/20\" data-kid=\"1-2-2-2-3\" data-name=\"login submit button\" type=\"button\">\n                    تسجيل الدخول\n                    <i aria-hidden=\"true\" class=\"icon-arrow-left text-[18px]\" data-kid=\"1-2-2-2-3-1\" data-name=\"arrow left icon\">\n                    </i>\n                </button>\n            </form>\n            <div class=\"mt-7 border-t border-[#eee4d1] pt-5 text-[13px] leading-6 text-[#765f4e]\" data-kid=\"1-2-2-3\" data-name=\"card footer info\">\n                <span data-kid=\"1-2-2-3-1\" data-name=\"footer department name\">\n                    قسم السنة الرابعة\n                </span>\n                <span class=\"mx-2 text-[#bb9457]\" data-kid=\"1-2-2-3-2\" data-name=\"separator dot\">\n                    ·\n                </span>\n                <span data-kid=\"1-2-2-3-3\" data-name=\"footer professor name\">\n                    الأستاذ عز الدين عويسي\n                </span>\n            </div>\n        </section>\n    </main>\n</div>\n",
