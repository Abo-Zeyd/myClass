      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.lesson-page { font-family: 'Noto Sans Arabic', sans-serif; color: #432818; background: #fff9ed; }\n.subject-scroll { scrollbar-width: thin; scrollbar-color: #bb9457 transparent; }\n@media (max-width: 767px) {\n  .subject-desktop { display: none !important; }\n  .subject-mobile { display: block !important; }\n  .lesson-shell { display: block !important; padding-inline: 18px !important; }\n  .lesson-content { padding: 24px 18px !important; }\n  .lesson-mobile-control { margin-bottom: 18px; }\n}\n</style>\n<div class=\"lesson-page min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#ead9b5] bg-[#fffdf8]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1200px] items-center justify-between px-6 max-sm:px-4\" data-kid=\"1-1-1\" data-name=\"header content wrapper\" dir=\"rtl\">\n            <a class=\"flex items-center gap-3 no-underline text-[#432818]\" data-kid=\"1-1-1-1\" data-name=\"header branding link\" href=\"#\">\n                <span aria-hidden=\"true\" class=\"flex size-11 items-center justify-center rounded-2xl bg-[#f3e9da] text-[#6f1d1b]\" data-kid=\"1-1-1-1-1\" data-name=\"header icon wrapper\">\n                    <i class=\"icon-graduation-cap text-[23px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    </i>\n                </span>\n                <span class=\"flex flex-col leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"header branding text group\">\n                    <span class=\"text-[17px] font-extrabold text-[#6f1d1b]\" data-kid=\"1-1-1-1-2-1\" data-name=\"header title text\">\n                        قسم السنة الرابعة\n                    </span>\n                    <span class=\"mt-1 text-[12px] font-medium text-[#765f4e]\" data-kid=\"1-1-1-1-2-2\" data-name=\"header teacher name text\">\n                        الأستاذ: عز الدين عويسي\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"flex items-center gap-2 text-[14px] font-bold\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\" dir=\"rtl\">\n                <a class=\"flex h-10 items-center gap-2 rounded-lg px-3 text-[#765f4e] no-underline hover:bg-[#f7efdf]\" data-kid=\"1-1-1-2-1\" data-name=\"home navigation link\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"icon-house text-[17px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"house icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"home link text\">\n                        الرئيسية\n                    </span>\n                </a>\n                <a aria-current=\"page\" class=\"flex h-10 items-center gap-2 rounded-lg bg-[#6f1d1b] px-4 text-white no-underline\" data-kid=\"1-1-1-2-2\" data-name=\"lessons navigation link\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"icon-book-open text-[17px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"book open icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"lessons link text\">\n                        الدروس\n                    </span>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"lesson-shell mx-auto flex max-w-[1200px] flex-row items-start gap-8 px-6 py-9 max-sm:px-4 max-sm:py-5\" data-kid=\"1-2\" data-name=\"main content area\" dir=\"rtl\">\n        <aside aria-label=\"مواد السنة الرابعة\" class=\"subject-desktop w-[260px] shrink-0 rounded-2xl border border-[#ead9b5] bg-[#fffdf8] p-4\" data-kid=\"1-2-1\" data-name=\"sidebar subject navigation\">\n            <h2 class=\"mb-3 px-3 pt-1 text-[15px] font-extrabold text-[#432818]\" data-kid=\"1-2-1-1\" data-name=\"sidebar heading\">\n                مواد السنة الرابعة\n            </h2>\n            <nav aria-label=\"اختيار المادة\" class=\"subject-scroll max-h-[690px] overflow-y-auto\" data-kid=\"1-2-1-2\" data-name=\"scrollable subject list container\">\n                <ul class=\"m-0 list-none space-y-1 p-0\" data-kid=\"1-2-1-2-1\" data-name=\"subject list\">\n                    <li data-kid=\"1-2-1-2-1-1\" data-name=\"subject button\">\n                        <button aria-pressed=\"true\" class=\"flex min-h-11 w-full items-center gap-3 rounded-xl bg-[#6f1d1b] px-3 text-right text-[14px] font-bold text-white\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"arabic language button\">\n                            <i aria-hidden=\"true\" class=\"icon-book-text text-[18px]\" data-kid=\"1-2-1-2-1-1-1-1\" data-name=\"book text icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-1-1-1-2\" data-name=\"arabic language button text\">\n                                اللغة العربية\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-chevron-left ms-auto text-[16px]\" data-kid=\"1-2-1-2-1-1-1-3\" data-name=\"chevron left icon\">\n                            </i>\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-1-2-1-2\" data-name=\"subject button\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 rounded-xl px-3 text-right text-[14px] font-semibold text-[#5c493b] hover:bg-[#f7efdf]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"islamic studies button\">\n                            <i aria-hidden=\"true\" class=\"icon-library text-[18px] text-[#8b7665]\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"library icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"islamic studies button text\">\n                                التربية الإسلامية\n                            </span>\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-1-2-1-3\" data-name=\"subject button\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 rounded-xl px-3 text-right text-[14px] font-semibold text-[#5c493b] hover:bg-[#f7efdf]\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"math button\">\n                            <i aria-hidden=\"true\" class=\"icon-calculator text-[18px] text-[#8b7665]\" data-kid=\"1-2-1-2-1-3-1-1\" data-name=\"calculator icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-1-3-1-2\" data-name=\"math button text\">\n                                الرياضيات\n                            </span>\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-1-2-1-4\" data-name=\"subject button\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 rounded-xl px-3 text-right text-[14px] font-semibold text-[#5c493b] hover:bg-[#f7efdf]\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"history button\">\n                            <i aria-hidden=\"true\" class=\"icon-history text-[18px] text-[#8b7665]\" data-kid=\"1-2-1-2-1-4-1-1\" data-name=\"history icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-1-4-1-2\" data-name=\"history button text\">\n                                التاريخ\n                            </span>\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-1-2-1-5\" data-name=\"subject button\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 rounded-xl px-3 text-right text-[14px] font-semibold text-[#5c493b] hover:bg-[#f7efdf]\" data-kid=\"1-2-1-2-1-5-1\" data-name=\"geography button\">\n                            <i aria-hidden=\"true\" class=\"icon-map text-[18px] text-[#8b7665]\" data-kid=\"1-2-1-2-1-5-1-1\" data-name=\"map icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-1-5-1-2\" data-name=\"geography button text\">\n                                الجغرافيا\n                            </span>\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-1-2-1-6\" data-name=\"subject button\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 rounded-xl px-3 text-right text-[14px] font-semibold text-[#5c493b] hover:bg-[#f7efdf]\" data-kid=\"1-2-1-2-1-6-1\" data-name=\"civic education button\">\n                            <i aria-hidden=\"true\" class=\"icon-scale text-[18px] text-[#8b7665]\" data-kid=\"1-2-1-2-1-6-1-1\" data-name=\"scale icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-1-6-1-2\" data-name=\"civic education button text\">\n                                التربية المدنية\n                            </span>\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-1-2-1-7\" data-name=\"subject button\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 rounded-xl px-3 text-right text-[14px] font-semibold text-[#5c493b] hover:bg-[#f7efdf]\" data-kid=\"1-2-1-2-1-7-1\" data-name=\"scientific education button\">\n                            <i aria-hidden=\"true\" class=\"icon-flask-conical text-[18px] text-[#8b7665]\" data-kid=\"1-2-1-2-1-7-1-1\" data-name=\"flask conical icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-1-7-1-2\" data-name=\"scientific education button text\">\n                                التربية العلمية\n                            </span>\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-1-2-1-8\" data-name=\"subject button\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 rounded-xl px-3 text-right text-[14px] font-semibold text-[#5c493b] hover:bg-[#f7efdf]\" data-kid=\"1-2-1-2-1-8-1\" data-name=\"recitations button\">\n                            <i aria-hidden=\"true\" class=\"icon-scroll-text text-[18px] text-[#8b7665]\" data-kid=\"1-2-1-2-1-8-1-1\" data-name=\"scroll text icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-1-8-1-2\" data-name=\"recitations button text\">\n                                المحفوظات\n                            </span>\n                        </button>\n                    </li>\n                </ul>\n            </nav>\n        </aside>\n        <section aria-labelledby=\"lessons-heading\" class=\"lesson-content min-w-0 flex-1 rounded-2xl border border-[#ead9b5] bg-[#fffdf8] px-8 py-7\" data-kid=\"1-2-2\" data-name=\"lessons section\">\n            <div class=\"subject-mobile lesson-mobile-control hidden\" data-kid=\"1-2-2-1\" data-name=\"mobile subject selection container\">\n                <label class=\"mb-2 block text-[14px] font-bold text-[#432818]\" data-kid=\"1-2-2-1-1\" data-name=\"mobile subject label\" for=\"mobile-subject\">\n                    المادة\n                </label>\n                <select class=\"h-12 w-full rounded-xl border border-[#d9c6a2] bg-[#fffdf8] px-4 text-[15px] font-semibold text-[#432818]\" data-kid=\"1-2-2-1-2\" data-name=\"mobile subject selector dropdown\" id=\"mobile-subject\">\n                    <option data-kid=\"1-2-2-1-2-1\">\n                        التربية الإسلامية\n                    </option>\n                    <option data-kid=\"1-2-2-1-2-2\" selected=\"\">\n                        اللغة العربية\n                    </option>\n                    <option data-kid=\"1-2-2-1-2-3\">\n                        الرياضيات\n                    </option>\n                    <option data-kid=\"1-2-2-1-2-4\">\n                        التاريخ\n                    </option>\n                    <option data-kid=\"1-2-2-1-2-5\">\n                        الجغرافيا\n                    </option>\n                    <option data-kid=\"1-2-2-1-2-6\">\n                        التربية المدنية\n                    </option>\n                    <option data-kid=\"1-2-2-1-2-7\">\n                        التربية العلمية\n                    </option>\n                    <option data-kid=\"1-2-2-1-2-8\">\n                        المحفوظات\n                    </option>\n                </select>\n            </div>\n            <header class=\"mb-6 flex items-end justify-between gap-5 border-b border-[#ead9b5] pb-5\" data-kid=\"1-2-2-2\" data-name=\"lessons section header\">\n                <div data-kid=\"1-2-2-2-1\" data-name=\"breadcrumb and heading container\">\n                    <p class=\"mb-1 text-[14px] font-semibold text-[#765f4e]\" data-kid=\"1-2-2-2-1-1\" data-name=\"breadcrumb path text\">\n                        مواد السنة الرابعة\n                        <span class=\"mx-1 text-[#bb9457]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"breadcrumb separator\">\n                            /\n                        </span>\n                        اللغة العربية\n                    </p>\n                    <h1 class=\"text-[28px] font-extrabold leading-tight text-[#432818] max-sm:text-[23px]\" data-kid=\"1-2-2-2-1-2\" data-name=\"lessons heading\" id=\"lessons-heading\">\n                        دروس اللغة العربية\n                    </h1>\n                </div>\n                <span class=\"mb-1 hidden items-center gap-2 text-[13px] font-medium text-[#765f4e] sm:flex\" data-kid=\"1-2-2-2-2\" data-name=\"instructional helper text\">\n                    <i aria-hidden=\"true\" class=\"icon-book-open text-[17px] text-[#6f1d1b]\" data-kid=\"1-2-2-2-2-1\" data-name=\"book open icon\">\n                    </i>\n                    اختر درسًا للعرض\n                </span>\n            </header>\n            <div class=\"space-y-3\" data-kid=\"1-2-2-3\" data-name=\"lessons list\">\n                <article aria-labelledby=\"lesson-diagnostic-title\" class=\"overflow-hidden rounded-xl border border-[#d8c29b] bg-white\" data-kid=\"1-2-2-3-1\" data-name=\"lesson accordion card\">\n                    <h2 class=\"m-0\" data-kid=\"1-2-2-3-1-1\" data-name=\"lesson accordion header\">\n                        <button aria-controls=\"diagnostic-content\" aria-expanded=\"true\" class=\"flex min-h-[58px] w-full items-center justify-between gap-4 bg-[#f8f0df] px-5 py-3 text-right text-[17px] font-bold text-[#432818]\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"lesson toggle button\">\n                            <span class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-2-3-1-1-1-1\" data-name=\"lesson icon wrapper\">\n                                <span class=\"flex size-8 shrink-0 items-center justify-center rounded-lg bg-[#ead9b5] text-[#6f1d1b]\" data-kid=\"1-2-2-3-1-1-1-1-1\" data-name=\"lesson icon\">\n                                    <i aria-hidden=\"true\" class=\"icon-book-open text-[17px]\" data-kid=\"1-2-2-3-1-1-1-1-1-1\" data-name=\"book open icon\">\n                                    </i>\n                                </span>\n                                <span data-kid=\"1-2-2-3-1-1-1-1-2\" data-name=\"lesson title\" id=\"lesson-diagnostic-title\">\n                                    تقويم تشخيصي\n                                </span>\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-chevron-down shrink-0 text-[18px] text-[#6f1d1b]\" data-kid=\"1-2-2-3-1-1-1-2\" data-name=\"chevron down icon\">\n                            </i>\n                        </button>\n                    </h2>\n                    <div class=\"px-5 pb-5 pt-4\" data-kid=\"1-2-2-3-1-2\" data-name=\"lesson content\" id=\"diagnostic-content\">\n                        <article aria-labelledby=\"reading-title\" class=\"border-r-2 border-[#bb9457] pr-5\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"reading comprehension section\">\n                            <h3 class=\"mb-3 flex items-center justify-between gap-3 text-[16px] font-bold text-[#6f1d1b]\" data-kid=\"1-2-2-3-1-2-1-1\" data-name=\"reading comprehension heading\" id=\"reading-title\">\n                                القراءة والفهم\n                                <button aria-label=\"نسخ رابط القراءة والفهم\" class=\"flex size-10 shrink-0 items-center justify-center rounded-lg text-[#765f4e] hover:bg-[#f7efdf]\" data-kid=\"1-2-2-3-1-2-1-1-1\" data-name=\"copy link button\" title=\"نسخ رابط القسم\">\n                                    <i aria-hidden=\"true\" class=\"icon-link text-[18px]\" data-kid=\"1-2-2-3-1-2-1-1-1-1\" data-name=\"link icon\">\n                                    </i>\n                                </button>\n                            </h3>\n                            <p class=\"max-w-[720px] text-[15px] leading-8 text-[#432818]\" data-kid=\"1-2-2-3-1-2-1-2\" data-name=\"reading comprehension description\">\n                                تساعد القراءة المتأنية على فهم النص واستخراج فكرته العامة وتفاصيله المهمة.\n                            </p>\n                            <div class=\"mt-4 grid gap-5 lg:grid-cols-[1fr_230px]\" data-kid=\"1-2-2-3-1-2-1-3\" data-name=\"lesson resources grid\">\n                                <section aria-labelledby=\"activities-title\" data-kid=\"1-2-2-3-1-2-1-3-1\" data-name=\"activities section\">\n                                    <h4 class=\"mb-2 text-[14px] font-bold text-[#5c493b]\" data-kid=\"1-2-2-3-1-2-1-3-1-1\" data-name=\"activities heading\" id=\"activities-title\">\n                                        أنشطة وتمارين\n                                    </h4>\n                                    <ol class=\"list-decimal space-y-2 pr-5 text-[14px] leading-7 text-[#432818] marker:font-bold marker:text-[#8b572d]\" data-kid=\"1-2-2-3-1-2-1-3-1-2\" data-name=\"activities list\">\n                                        <li data-kid=\"1-2-2-3-1-2-1-3-1-2-1\">\n                                            اقرأ نصاً قصيراً بصوت واضح، ثم اذكر فكرته العامة.\n                                        </li>\n                                        <li data-kid=\"1-2-2-3-1-2-1-3-1-2-2\">\n                                            استخرج من النص كلمة تدل على المكان، واشرح معناها من السياق.\n                                        </li>\n                                    </ol>\n                                </section>\n                                <section aria-labelledby=\"materials-title\" class=\"border-t border-[#ead9b5] pt-4 lg:border-r lg:border-t-0 lg:pr-5 lg:pt-0\" data-kid=\"1-2-2-3-1-2-1-3-2\" data-name=\"materials section\">\n                                    <h4 class=\"mb-2 text-[14px] font-bold text-[#5c493b]\" data-kid=\"1-2-2-3-1-2-1-3-2-1\" data-name=\"materials heading\" id=\"materials-title\">\n                                        مواد الدرس\n                                    </h4>\n                                    <a class=\"flex min-h-12 items-center gap-3 rounded-lg px-2 text-[14px] font-semibold text-[#6f1d1b] underline decoration-[#d8c29b] underline-offset-4 hover:bg-[#f8f0df]\" data-kid=\"1-2-2-3-1-2-1-3-2-2\" data-name=\"reading materials link\" href=\"#\">\n                                        <i aria-hidden=\"true\" class=\"icon-image text-[19px]\" data-kid=\"1-2-2-3-1-2-1-3-2-2-1\" data-name=\"image icon\">\n                                        </i>\n                                        <span data-kid=\"1-2-2-3-1-2-1-3-2-2-2\" data-name=\"reading material link text\">\n                                            كتاب مفتوح ونص للقراءة\n                                        </span>\n                                    </a>\n                                    <a class=\"mt-1 flex min-h-12 items-center gap-3 rounded-lg px-2 text-[14px] font-semibold text-[#6f1d1b] underline decoration-[#d8c29b] underline-offset-4 hover:bg-[#f8f0df]\" data-kid=\"1-2-2-3-1-2-1-3-2-3\" data-name=\"video materials link\" href=\"#\">\n                                        <i aria-hidden=\"true\" class=\"icon-circle-play text-[19px]\" data-kid=\"1-2-2-3-1-2-1-3-2-3-1\" data-name=\"circle play icon\">\n                                        </i>\n                                        <span data-kid=\"1-2-2-3-1-2-1-3-2-3-2\" data-name=\"video material link text\">\n                                            فيديو القراءة والفهم\n                                        </span>\n                                        <i aria-hidden=\"true\" class=\"icon-external-link ms-auto text-[16px]\" data-kid=\"1-2-2-3-1-2-1-3-2-3-3\" data-name=\"external link icon\">\n                                        </i>\n                                    </a>\n                                </section>\n                            </div>\n                        </article>\n                        <div class=\"mt-5 border-t border-[#efe5d1] pt-4\" data-kid=\"1-2-2-3-1-2-2\" data-name=\"composition section footer\">\n                            <h3 class=\"flex items-center justify-between gap-3 text-[15px] font-semibold text-[#5c493b]\" data-kid=\"1-2-2-3-1-2-2-1\" data-name=\"composition title container\">\n                                <span data-kid=\"1-2-2-3-1-2-2-1-1\" data-name=\"composition heading\">\n                                    التعبير الكتابي\n                                </span>\n                                <button aria-label=\"فتح التعبير الكتابي\" class=\"flex size-10 shrink-0 items-center justify-center rounded-lg text-[#765f4e] hover:bg-[#f7efdf]\" data-kid=\"1-2-2-3-1-2-2-1-2\" data-name=\"add composition button\">\n                                    <i aria-hidden=\"true\" class=\"icon-plus text-[18px]\" data-kid=\"1-2-2-3-1-2-2-1-2-1\" data-name=\"plus icon\">\n                                    </i>\n                                </button>\n                            </h3>\n                        </div>\n                    </div>\n                </article>\n                <details class=\"group rounded-xl border border-[#ead9b5] bg-[#fffdf8]\" data-kid=\"1-2-2-3-2\" data-name=\"lesson details card\">\n                    <summary class=\"flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 text-[15px] font-semibold text-[#432818]\" data-kid=\"1-2-2-3-2-1\" data-name=\"lesson details toggle summary\">\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"lesson title with icon\">\n                            <i aria-hidden=\"true\" class=\"icon-book-open text-[17px] text-[#8b7665]\" data-kid=\"1-2-2-3-2-1-1-1\" data-name=\"book open icon\">\n                            </i>\n                            مع عصاي في المدرسة\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-chevron-down text-[17px] text-[#8b7665] group-open:rotate-180\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"chevron down icon\">\n                        </i>\n                    </summary>\n                </details>\n                <details class=\"group rounded-xl border border-[#ead9b5] bg-[#fffdf8]\" data-kid=\"1-2-2-3-3\" data-name=\"lesson details card\">\n                    <summary class=\"flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 text-[15px] font-semibold text-[#432818]\" data-kid=\"1-2-2-3-3-1\" data-name=\"lesson details toggle summary\">\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-2-3-3-1-1\" data-name=\"lesson title with icon\">\n                            <i aria-hidden=\"true\" class=\"icon-book-open text-[17px] text-[#8b7665]\" data-kid=\"1-2-2-3-3-1-1-1\" data-name=\"book open icon\">\n                            </i>\n                            ماسح الزجاج\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-chevron-down text-[17px] text-[#8b7665] group-open:rotate-180\" data-kid=\"1-2-2-3-3-1-2\" data-name=\"chevron down icon\">\n                        </i>\n                    </summary>\n                </details>\n                <details class=\"group rounded-xl border border-[#ead9b5] bg-[#fffdf8]\" data-kid=\"1-2-2-3-4\" data-name=\"lesson details card\">\n                    <summary class=\"flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 text-[15px] font-semibold text-[#432818]\" data-kid=\"1-2-2-3-4-1\" data-name=\"lesson details toggle summary\">\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-2-3-4-1-1\" data-name=\"lesson title with icon\">\n                            <i aria-hidden=\"true\" class=\"icon-book-open text-[17px] text-[#8b7665]\" data-kid=\"1-2-2-3-4-1-1-1\" data-name=\"book open icon\">\n                            </i>\n                            جدّتي\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-chevron-down text-[17px] text-[#8b7665] group-open:rotate-180\" data-kid=\"1-2-2-3-4-1-2\" data-name=\"chevron down icon\">\n                        </i>\n                    </summary>\n                </details>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#ead9b5] bg-[#fffdf8] py-5 text-center text-[13px] text-[#765f4e]\" data-kid=\"1-3\" data-name=\"footer section\">\n        © 2026 قسم السنة الرابعة - الأستاذ عز الدين عويسي. جميع الحقوق محفوظة.\n    </footer>\n</div>\n",
