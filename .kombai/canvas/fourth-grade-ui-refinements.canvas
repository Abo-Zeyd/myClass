      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[var(--page)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" lang=\"ar\" style=\"--page:#fff9ed;--ink:#432818;--surface:#fffdf8;--sand:#f5e7c7;--gold:#bb9457;--wine:#6f1d1b;--clay:#99582a;--muted:#765f4e;--edge:#ead9b5; font-family:'Noto Sans Arabic',sans-serif\">\n    <header class=\"border-b border-[var(--edge)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1120px] items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"header layout wrapper\">\n            <a aria-label=\"الرئيسية — قسم السنة الرابعة\" class=\"flex items-center gap-3 no-underline text-[var(--ink)]\" data-kid=\"1-1-1-1\" data-name=\"header logo and title link\" href=\"/\">\n                <span class=\"flex size-11 items-center justify-center rounded-xl bg-[var(--wine)] text-xl text-white\" data-kid=\"1-1-1-1-1\" data-name=\"book icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-book-2\" data-kid=\"1-1-1-1-1-1\" data-name=\"book icon\">\n                    </i>\n                </span>\n                <span class=\"flex flex-col leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"header title group\">\n                    <span class=\"text-base font-extrabold text-[var(--wine)] sm:text-lg\" data-kid=\"1-1-1-1-2-1\" data-name=\"department name headline\">\n                        قسم السنة الرابعة\n                    </span>\n                    <span class=\"mt-1 text-xs font-medium text-[var(--muted)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"teacher name subheadline\">\n                        الأستاذ عز الدين عويسي\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"flex items-center gap-2 text-sm font-bold sm:gap-5\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a aria-current=\"page\" class=\"flex min-h-11 items-center gap-2 rounded-lg bg-[var(--sand)] px-4 text-[var(--wine)] no-underline\" data-kid=\"1-1-1-2-1\" data-name=\"navigation home link\" href=\"/\">\n                    <i aria-hidden=\"true\" class=\"ti ti-home text-lg\" data-kid=\"1-1-1-2-1-1\" data-name=\"home icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"home label\">\n                        الرئيسية\n                    </span>\n                </a>\n                <a class=\"flex min-h-11 items-center gap-2 rounded-lg px-4 text-[var(--ink)] no-underline hover:bg-[var(--sand)]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation lessons link\" href=\"/lessons\">\n                    <i aria-hidden=\"true\" class=\"ti ti-book text-lg text-[var(--gold)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"lessons icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"lessons label\">\n                        الدروس\n                    </span>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1080px] px-6 pb-16 pt-10 sm:pt-14\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"welcome-title\" class=\"flex flex-col justify-between gap-6 border-b border-[var(--edge)] pb-8 sm:flex-row sm:items-end sm:pb-10\" data-kid=\"1-2-1\" data-name=\"welcome section\">\n            <div class=\"max-w-[720px]\" data-kid=\"1-2-1-1\" data-name=\"welcome text content\">\n                <h1 class=\"m-0 text-[30px] font-extrabold leading-[1.45] tracking-tight text-[var(--wine)] sm:text-[38px]\" data-kid=\"1-2-1-1-1\" data-name=\"welcome headline\" id=\"welcome-title\">\n                    أهلاً بكم في قسم السنة الرابعة\n                </h1>\n                <p class=\"mb-0 mt-3 max-w-[690px] text-base leading-8 text-[var(--muted)] sm:text-lg\" data-kid=\"1-2-1-1-2\" data-name=\"welcome description text\">\n                    دروس وواجبات وأنشطة داعمة لتلاميذ القسم وأوليائهم.\n                </p>\n            </div>\n            <a class=\"inline-flex min-h-12 shrink-0 items-center justify-center gap-2 self-start rounded-lg bg-[var(--wine)] px-5 text-sm font-bold text-white no-underline hover:bg-[var(--clay)] sm:self-auto\" data-kid=\"1-2-1-2\" data-name=\"lessons call-to-action button\" href=\"/lessons\">\n                <span data-kid=\"1-2-1-2-1\" data-name=\"lessons call-to-action text\">\n                    تصفح الدروس\n                </span>\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-left text-lg\" data-kid=\"1-2-1-2-2\" data-name=\"arrow left icon\">\n                </i>\n            </a>\n        </section>\n        <section aria-label=\"تنبيهات القسم\" class=\"mt-5 flex items-center gap-3 border-b border-[var(--edge)] py-4\" data-kid=\"1-2-2\" data-name=\"announcements section\">\n            <span class=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-[var(--sand)] text-lg text-[var(--wine)]\" data-kid=\"1-2-2-1\" data-name=\"bell icon container\">\n                <i aria-hidden=\"true\" class=\"ti ti-bell\" data-kid=\"1-2-2-1-1\" data-name=\"bell icon\">\n                </i>\n            </span>\n            <p class=\"m-0 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-2-2\" data-name=\"announcements text\">\n                لا توجد تنبيهات جديدة حالياً.\n            </p>\n        </section>\n        <section aria-labelledby=\"assignments-title\" class=\"mt-9\" data-kid=\"1-2-3\" data-name=\"assignments section\">\n            <div class=\"mb-3 flex flex-wrap items-end justify-between gap-3 border-b-2 border-[var(--wine)] pb-4\" data-kid=\"1-2-3-1\" data-name=\"assignments header\">\n                <div data-kid=