ata-name=\"thumbnail image container\">\n                            <img alt=\"كتاب مفتوح ونص للقراءة\" class=\"size-[68px] object-contain\" data-kid=\"1-2-4-2-3-2-1-1\" data-name=\"thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/lessons/reading.svg\"/>\n                        </div>\n                        <div class=\"grid min-w-0 gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)_44px] sm:items-end\" data-kid=\"1-2-4-2-3-2-2\" data-name=\"image metadata container\">\n                            <label class=\"grid gap-1.5 text-sm font-semibold text-[#432818]\" data-kid=\"1-2-4-2-3-2-2-1\" data-name=\"image path label\">\n                                مسار الصورة أو رابطها\n                                <input class=\"h-11 min-w-0 rounded-md border border-[#d9c8a7] bg-[#fffdf8] px-3 text-sm font-normal text-[#432818] outline-none focus:border-[#6f1d1b] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-4-2-3-2-2-1-1\" data-name=\"image path input\" value=\"/myClass/images/lessons/reading.svg\"/>\n                            </label>\n                            <label class=\"grid gap-1.5 text-sm font-semibold text-[#432818]\" data-kid=\"1-2-4-2-3-2-2-2\" data-name=\"image alt text label\">\n                                وصف الصورة\n                                <input class=\"h-11 min-w-0 rounded-md border border-[#d9c8a7] bg-[#fffdf8] px-3 text-sm font-normal text-[#432818] outline-none focus:border-[#6f1d1b] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-4-2-3-2-2-2-1\" data-name=\"image alt input\" value=\"كتاب مفتوح ونص للقراءة\"/>\n                            </label>\n                            <button aria-label=\"حذف الصورة\" class=\"flex size-11 items-center justify-center rounded-md text-[#8e3b32] hover:bg-[#f6e4df]\" data-kid=\"1-2-4-2-3-2-2-3\" data-name=\"delete image button\" title=\"حذف الصورة\">\n                                <i aria-hidden=\"true\" class=\"ti ti-trash text-lg\" data-kid=\"1-2-4-2-3-2-2-3-1\" data-name=\"trash icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <button class=\"mt-2 inline-flex min-h-10 items-center gap-2 rounded-md px-2 text-sm font-bold text-[#6f1d1b] hover:bg-[#f7efdf]\" data-kid=\"1-2-4-2-3-3\" data-name=\"add image button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-plus text-lg\" data-kid=\"1-2-4-2-3-3-1\" data-name=\"plus icon\">\n                        </i>\n                        إضافة صورة\n                    </button>\n                </div>\n                <div class=\"mt-6 border-t border-[#ead9b5] pt-5\" data-kid=\"1-2-4-2-4\" data-name=\"videos section\">\n                    <h3 class=\"mb-4 text-lg font-extrabold text-[#432818]\" data-kid=\"1-2-4-2-4-1\" data-name=\"section title\">\n                        الفيديوهات\n                    </h3>\n                    <div class=\"grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,0.7fr)_44px] sm:items-end\" data-kid=\"1-2-4-2-4-2\" data-name=\"video item entry\">\n                        <label class=\"grid gap-1.5 text-sm font-semibold text-[#432818]\" data-kid=\"1-2-4-2-4-2-1\" data-name=\"video URL label\">\n                            رابط الفيديو\n                            <input class=\"h-11 min-w-0 rounded-md border border-[#d9c8a7] bg-[#fffdf8] px-3 text-sm font-normal text-[#432818] outline-none focus:border-[#6f1d1b] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-4-2-4-2-1-1\" data-name=\"video URL input\" value=\"https://youtu.be/CZbuZRd53tA\"/>\n                        </label>\n                        <label class=\"grid gap-1.5 text-sm font-semibold text-[#432818]\" data-kid=\"1-2-4-2-4-2-2\" data-name=\"video title label\">\n                            عنوان الفيديو\n                            <input class=\"h-11 min-w-0 rounded-md border border-[#d9c8a7] bg-[#fffdf8] px-3 text-sm font-normal text-[#432818] outline-none focus:border-[#6f1d1b] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-4-2-4-2-2-1\" data-name=\"video title input\" value=\"فيديو القراءة والفهم\"/>\n                        </label>\n                        <button aria-label=\"حذف الفيديو\" class=\"flex size-11 items-center justify-center rounded-md text-[#8e3b32] hover:bg-[#f6e4df]\" data-kid=\"1-2-4-2-4-2-3\" data-name=\"delete video button\" title=\"حذف الفيديو\">\n                            <i aria-hidden=\"true\" class=\"ti ti-trash text-lg\" data-kid=\"1-2-4-2-4-2-3-1\" data-name=\"trash icon\">\n                            </i>\n                        </button>\n                    </div>\n                    <button class=\"mt-2 inline-flex min-h-10 items-center gap-2 rounded-md px-2 text-sm font-bold text-[#6f1d1b] hover:bg-[#f7efdf]\" data-kid=\"1-2-4-2-4-3\" data-name=\"add video button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-plus text-lg\" data-kid=\"1-2-4-2-4-3-1\" data-name=\"plus icon\">\n                        </i>\n                        إضافة فيديو\n                    </button>\n                </div>\n                <div class=\"mt-6 border-t border-[#ead9b5] pt-5\" data-kid=\"1-2-4-2-5\" data-name=\"pdf section\">\n                    <div class=\"flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-2-4-2-5-1\" data-name=\"pdf header container\">\n                        <div data-kid=\"1-2-4-2-5-1-1\" data-name=\"pdf text container\">\n                            <h3 class=\"text-lg font-extrabold text-[#432818]\" data-kid=\"1-2-4-2-5-1-1-1\" data-name=\"pdf section title\">\n                                ملفات PDF\n                            </h3>\n                            <p class=\"mt-1 text-sm text-[#765f4e]\" data-kid=\"1-2-4-2-5-1-1-2\" data-name=\"no files text\">\n                                لا توجد ملفات PDF مضافة لهذا المحتوى.\n                            </p>\n                        </div>\n                        <button class=\"inline-flex min-h-10 items-center gap-2 rounded-md border border-[#d9c8a7] bg-[#fffdf8] px-3 text-sm font-bold text-[#6f1d1b] hover:bg-[#fff3d8]\" data-kid=\"1-2-4-2-5-1-2\" data-name=\"add pdf button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-plus text-lg\" data-kid=\"1-2-4-2-5-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                            إضافة ملف PDF\n                        </button>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n",
