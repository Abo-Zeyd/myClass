      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen bg-[#fff9ed] text-[#432818]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" style=\"font-family:'Noto Sans Arabic',sans-serif\">\n    <header class=\"border-b border-[#ead9b5] bg-[#fffdf8]\" data-kid=\"1-1\" data-name=\"header area\">\n        <div class=\"mx-auto flex h-[72px] max-w-[1240px] items-center justify-between px-7\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-1\" data-name=\"profile and info container\">\n                <div class=\"flex size-11 items-center justify-center rounded-xl bg-[#f3e8dc] text-[#6f1d1b]\" data-kid=\"1-1-1-1-1\" data-name=\"profile icon wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-school text-2xl\" data-kid=\"1-1-1-1-1-1\" data-name=\"school icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"profile information text group\">\n                    <p class=\"text-[17px] font-extrabold leading-tight text-[#6f1d1b]\" data-kid=\"1-1-1-1-2-1\" data-name=\"teacher title\">\n                        قسم السنة الرابعة\n                    </p>\n                    <p class=\"mt-0.5 text-sm font-medium text-[#765f4e]\" data-kid=\"1-1-1-1-2-2\" data-name=\"teacher name\">\n                        الأستاذ: عز الدين عويسي\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-1-1-2\" data-name=\"header actions container\">\n                <span class=\"hidden text-sm font-semibold text-[#765f4e] md:inline\" data-kid=\"1-1-1-2-1\" data-name=\"content dashboard label\">\n                    لوحة المحتوى\n                </span>\n                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#ead9b5] bg-[#fffdf8] px-4 text-sm font-bold text-[#432818] hover:bg-[#fff3d8]\" data-kid=\"1-1-1-2-2\" data-name=\"logout button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-logout text-lg\" data-kid=\"1-1-1-2-2-1\" data-name=\"logout icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"logout button text\">\n                        خروج\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1240px] px-7 pb-12 pt-8\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-6 flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-2-1\" data-name=\"page header container\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title and description\">\n                <h1 class=\"text-3xl font-extrabold tracking-tight text-[#432818]\" data-kid=\"1-2-1-1-1\" data-name=\"main page headline\">\n                    إدارة محتوى الدروس\n                </h1>\n                <p class=\"mt-1 text-base text-[#765f4e]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    اختر المادة والدرس لتعديل محتوى التلاميذ.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\" data-name=\"page primary actions container\">\n                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#d9c8a7] bg-[#fffdf8] px-4 text-sm font-bold text-[#6f1d1b] hover:bg-[#fff3d8]\" data-kid=\"1-2-1-2-1\" data-name=\"add lesson button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-plus text-lg\" data-kid=\"1-2-1-2-1-1\" data-name=\"plus icon\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-1-2\" data-name=\"add lesson button text\">\n                        إضافة درس\n                    </span>\n                </button>\n                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg bg-[#6f1d1b] px-5 text-sm font-bold text-white shadow-sm hover:bg-[#581615]\" data-kid=\"1-2-1-2-2\" data-name=\"save lesson button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-device-floppy text-lg\" data-kid=\"1-2-1-2-2-1\" data-name=\"save icon\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-2-2\" data-name=\"save button text\">\n                        حفظ دروس المادة\n                    </span>\n                </button>\n            </div>\n        </div>\n        <nav aria-label=\"أقسام لوحة التحكم\" class=\"mb-7 flex flex-wrap items-center gap-1 border-b border-[#ead9b5] pb-3\" data-kid=\"1-2-2\" data-name=\"navigation tabs\" role=\"tablist\">\n            <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-4 text-sm font-semibold text-[#765f4e] hover:bg-[#fff3d8]\" data-kid=\"1-2-2-1\" data-name=\"notifications and images tab button\">\n                <i aria-hidden=\"true\" class=\"ti ti-speakerphone text-lg\" data-kid=\"1-2-2-1-1\" data-name=\"notifications icon\">\n                </i>\n                التنبيهات والصور\n            </button>\n            <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-4 text-sm font-semibold text-[#765f4e] hover:bg-[#fff3d8]\" data-kid=\"1-2-2-2\" data-name=\"supportive activities tab button\">\n                <i aria-hidden=\"true\" class=\"ti ti-checkbox text-lg\" data-kid=\"1-2-2-2-1\" data-name=\"checkbox icon\">\n                </i>\n                الأنشطة الداعمة\n            </button>\n            <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-4 text-sm font-semibold text-[#765f4e] hover:bg-[#fff3d8]\" data-kid=\"1-2-2-3\" data-name=\"homework tab button\">\n                <i aria-hidden=\"true\" class=\"ti ti-clipboard-list text-lg\" data-kid=\"1-2-2-3-1\" data-name=\"clipboard icon\">\n                </i>\n                الواجبات\n            </button>\n            <button aria-selected=\"true\" class=\"inline-flex min-h-11 items-center gap-2 rounded-lg bg-[#6f1d1b] px-4 text-sm font-bold text-white\" data-kid=\"1-2-2-4\" data-name=\"lessons tab button\">\n                <i aria-hidden=\"true\" class=\"ti ti-book-2 text-lg\" data-kid=\"1-2-2-4-1\" data-name=\"book icon\">\n                </i>\n                الدروس\n            </button>\n        </nav>\n        <div class=\"mb-7 flex flex-wrap items-end justify-between gap-5 border-b border-[#ead9b5] pb-6\" data-kid=\"1-2-3\" data-name=\"lesson selection controls\">\n            <label class=\"grid min-w-[290px] gap-2 text-sm font-bold text-[#432818]\" data-kid=\"1-2-3-1\" data-name=\"subject selection label\">\n                المادة\n                <span class=\"relative\" data-kid=\"1-2-3-1-1\" data-name=\"select wrapper\">\n                    <select class=\"h-12 w-full appearance-none rounded-lg border border-[#d9c8a7] bg-[#fffdf8] px-4 pe-11 text-base font-semibold text-[#432818] outline-none focus:border-[#6f1d1b] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-3-1-1-1\" data-name=\"subject select input\">\n                        <option data-kid=\"1-2-3-1-1-1-1\">\n                            اللغة العربية\n                        </option>\n                        <option data-kid=\"1-2-3-1-1-1-2\">\n                            التربية الإسلامية\n                        </option>\n                        <option data-kid=\"1-2-3-1-1-1-3\">\n                            الرياضيات\n                        </option>\n                        <option data-kid=\"1-2-3-1-1-1-4\">\n                            التاريخ\n                        </option>\n                        <option data-kid=\"1-2-3-1-1-1-5\">\n                            الجغرافيا\n                        </option>\n                        <option data-kid=\"1-2-3-1-1-1-6\">\n                            التربية المدنية\n                        </option>\n                        <option data-kid=\"1-2-3-1-1-1-7\">\n                            التربية العلمية\n                        </option>\n                        <option data-kid=\"1-2-3-1-1-1-8\">\n                            المحفوظات\n                        </option>\n                    </select>\n                    <i aria-hidden=\"true\" class=\"ti ti-chevron-down pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-lg text-[#765f4e]\" data-kid=\"1-2-3-1-1-2\" data-name=\"chevron down icon\">\n                    </i>\n                </span>\n            </label>\n            <p class=\"pb-3 text-sm text-[#765f4e]\" data-kid=\"1-2-3-2\" data-name=\"save reminder text\">\n                التعديلات لا تُحفظ إلا بعد الضغط على «حفظ دروس المادة».\n            </p>\n        </div>\n        <div class=\"grid grid-cols-[300px_minmax(0,1fr)] items-start gap-10\" data-kid=\"1-2-4\" data-name=\"editor split view container\">\n            <aside aria-label=\"دروس اللغة العربية\" class=\"min-w-0 border-l border-[#ead9b5] pl-6\" data-kid=\"1-2-4-1\" data-name=\"lesson sidebar\">\n                <div class=\"mb-4 flex items-center justify-between gap-3\" data-kid=\"1-2-4-1-1\" data-name=\"sidebar header container\">\n                    <h2 class=\"text-lg font-extrabold text-[#432818]\" data-kid=\"1-2-4-1-1-1\" data-name=\"sidebar title\">\n                        دروس اللغة العربية\n                    </h2>\n                    <button aria-label=\"إضافة درس\" class=\"flex size-10 items-center justify-center rounded-lg text-[#6f1d1b] hover:bg-[#f5ead5]\" data-kid=\"1-2-4-1-1-2\" data-name=\"add lesson sidebar button\" title=\"إضافة درس\">\n                        <i aria-hidden=\"true\" class=\"ti ti-plus text-xl\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <ul clas