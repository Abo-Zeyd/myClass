      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#fff9ed] text-[#432818] [font-family:'Noto_Sans_Arabic',sans-serif]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\">\n    <header class=\"border-b border-[#ead9b5] bg-[#fffdf8]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex h-[74px] max-w-[1180px] items-center justify-between gap-6 px-5 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"logo and teacher info group\">\n                <span class=\"flex size-11 shrink-0 items-center justify-center rounded-xl bg-[#f2e6d8] text-[#6f1d1b]\" data-kid=\"1-1-1-1-1\" data-name=\"graduation icon container\">\n                    <i aria-hidden=\"true\" class=\"icon-graduation-cap text-[23px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    </i>\n                </span>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"teacher info text container\">\n                    <a class=\"block truncate text-[17px] font-extrabold leading-tight text-[#6f1d1b]\" data-kid=\"1-1-1-1-2-1\" data-name=\"department title link\" href=\"/\">\n                        قسم السنة الرابعة\n                    </a>\n                    <p class=\"mt-0.5 text-[12px] font-medium text-[#765f4e]\" data-kid=\"1-1-1-1-2-2\" data-name=\"teacher name text\">\n                        الأستاذ: عز الدين عويسي\n                    </p>\n                </div>\n            </div>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"flex shrink-0 items-center gap-1 text-[14px] font-semibold sm:gap-2\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-[#765f4e] hover:bg-[#f8f0e4] hover:text-[#6f1d1b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6f1d1b] sm:px-4\" data-kid=\"1-1-1-2-1\" data-name=\"home page link\" href=\"/\">\n                    <i aria-hidden=\"true\" class=\"icon-house text-[18px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"home icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"home link text\">\n                        الرئيسية\n                    </span>\n                </a>\n                <a aria-current=\"page\" class=\"inline-flex min-h-11 items-center gap-2 rounded-lg bg-[#6f1d1b] px-3 text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6f1d1b] sm:px-4\" data-kid=\"1-1-1-2-2\" data-name=\"lessons page link\" href=\"/lessons\">\n                    <i aria-hidden=\"true\" class=\"icon-book-open text-[18px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"book open icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"lessons link text\">\n                        الدروس\n                    </span>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1180px] px-5 pb-12 pt-8 sm:px-8 sm:pt-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-7 flex flex-wrap items-end justify-between gap-3 border-b border-[#ead9b5] pb-5\" data-kid=\"1-2-1\" data-name=\"page header section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"title and description container\">\n                <h1 class=\"text-[27px] font-extrabold leading-tight tracking-[-0.02em] text-[#432818] sm:text-[31px]\" data-kid=\"1-2-1-1-1\" data-name=\"main page headline\">\n                    استكشاف الدروس\n                </h1>\n                <p class=\"mt-2 text-[15px] leading-7 text-[#765f4e]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    اختر مادة لعرض دروسها وملخصاتها.\n                </p>\n            </div>\n            <span class=\"hidden items-center gap-2 pb-1 text-[13px] font-semibold text-[#765f4e] md:inline-flex\" data-kid=\"1-2-1-2\" data-name=\"subjects list indicator\">\n                <i aria-hidden=\"true\" class=\"icon-book-marked text-[17px] text-[#99582a]\" data-kid=\"1-2-1-2-1\" data-name=\"book marked icon\">\n                </i>\n                مواد السنة الرابعة\n            </span>\n        </div>\n        <div class=\"grid items-start gap-7 md:grid-cols-[minmax(0,1fr)_258px] md:gap-9\" data-kid=\"1-2-2\" data-name=\"content grid container\">\n            <section aria-labelledby=\"selected-subject-title\" class=\"min-w-0\" data-kid=\"1-2-2-1\" data-name=\"lesson section\">\n                <div class=\"mb-5 flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"selected subject header container\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-1-1\" data-name=\"selected subject icon and title group\">\n                        <span class=\"flex size-10 items-center justify-center rounded-lg bg-[#f4e3bd] text-[#6f1d1b]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"subject icon container\">\n                            <i aria-hidden=\"true\" class=\"icon-book-open text-[21px]\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"book open icon\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-2-2-1-1-1-2\" data-name=\"subject title text container\">\n                            <p class=\"text-[13px] font-semibold text-[#765f4e]\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"subject label text\">\n                                المادة المختارة\n                            </p>\n                            <h2 class=\"text-[21px] font-extrabold leading-tight text-[#6f1d1b]\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"selected subject title\" id=\"selected-subject-title\">\n                                اللغة العربية\n                            </h2>\n                        </div>\n                    </div>\n                    <button aria-label=\"اختيار مادة أخرى\" class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#d8c6a4] bg-[#fffdf8] px-3 text-[13px] font-bold text-[#6f1d1b] hover:bg-[#f8f0e4] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6f1d1b] md:hidden\" data-kid=\"1-2-2-1-1-2\" data-name=\"select subject mobile button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-list-filter text-[17px]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"list filter icon\">\n                        </i>\n                        المواد\n                    </button>\n                </div>\n                <div class=\"overflow-hidden rounded-xl border border-[#ead9b5] bg-[#fffdf8]\" data-kid=\"1-2-2-1-2\" data-name=\"lesson card container\">\n                    <div class=\"flex min-h-[62px] items-center justify-between gap-4 border-b border-[#ead9b5] bg-[#f8f0e4] px-5 py-3 sm:px-6\" data-kid=\"1-2-2-1-2-1\" data-name=\"lesson card header\">\n                        <h3 class=\"text-[17px] font-bold text-[#432818]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"lesson title\">\n                            تقويم تشخيصي\n                        </h3>\n                        <span class=\"flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#6f1d1b] text-white\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"chevron icon container\">\n                            <i aria-hidden=\"true\" class=\"icon-chevron-up text-[19px]\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"chevron up icon\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"px-5 pb-6 pt-5 sm:px-6\" data-kid=\"1-2-2-1-2-2\" data-name=\"lesson content area\">\n                        <div class=\"mb-3 flex items-start justify-between gap-3\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"lesson info header\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"lesson section title group\">\n                                <span class=\"mt-0.5 text-[18px] font-bold text-[#bb9457]\" data-kid=\"1-2-2-1-2-2-1-1-1\" data-name=\"lesson number\">\n                                    ١\n                                </span>\n                                <h4 class=\"text-[18px] font-bold text-[#432818]\" data-kid=\"1-2-2-1-2-2-1-1-2\" data-name=\"lesson subtitle\">\n                                    القراءة والفهم\n                                </h4>\n                            </div>\n                            <button aria-label=\"نسخ رابط القراءة والفهم\" class=\"flex size-11 shrink-0 items-center justify-center rounded-lg text-[#6f1d1b] hover:bg-[#f4e3bd] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6f1d1b]\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"copy link button\" title=\"نسخ رابط المحتوى\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"icon-link-2 text-[18px]\" data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"link icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <p class=\"mb-6 pr-8 text-[15px] leading-8 text-[#5f4939]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"lesson description text\">\n                            تساعد القراءة المتأنية على فهم النص واستخراج فكرته العامة وتفاصيله المهمة.\n                        </p>\n                        <div class=\"mb-6 border-r-2 border-[#e8d4ae] pr-5\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"activities container\">\n                            <h5 class=\"mb-2 text-[15px] font-bold text-[#6f1d1b]\" data-kid=\"1-2-2-1-2-2-3-1\" data-name=\"activities title\">\n                                أنشطة وتمارين\n                            </h5>\n                            <ol class=\"space-y-2 text-[14px] leading-7 text-[#432818]\" data-kid=\"1-2-2-1-2-2-3-2\" data-name=\"activities list\">\n                                <li class=\"flex gap-3\" data-kid=\"1-2-2-1-2-2-3-2-1\" data-name=\"activity one item\">\n                                    <span class=\"font-bold text-[#bb9457]\" data-kid=\"1-2-2-1-2-2-3-2-1-1\" data-name=\"activity one number\">\n                                        ١.\n                                    </span>\n                                    <span data-kid=\"1-2-2-1-2-2-3-2-1-2\" data-name=\"activity one text\">\n                                        اقرأ نصاً قصيراً بصوت واضح، ثم اذكر فكرته العامة.\n                                    </span>\n                                </li>\n                                <li class=\"flex gap-3\" data-kid=\"1-2-2-1-2-2-3-2-2\" data-name=\"activity two item\">\n                                    <span class=\"font-bold text-[#bb9457]\" data-kid=\"1-2-2-1-2-2-3-2-2-1\" data-name=\"activity two number\">\n                                        ٢.\n                                    </span>\n                                    <span data-kid=\"1-2-2-1-2-2-3-2-2-2\" data-name=\"activity two text\">\n                                        استخرج من النص كلمة تدل على المكان، واشرح معناها من السياق.\n                                    </span>\n                                </li>\n                            </ol>\n                        </div>\n                        <div class=\"grid gap-5 border-t border-[#ead9b5] pt-5 sm:grid-cols-[190px_minmax(0,1fr)] sm:items-center\" data-kid=\"1-2-2-1-2-2-4\" data-name=\"lesson media container\">\n                            <figure class=\"overflow-hidden rounded-lg bg-[#f8f0e4]\" data-kid=\"1-2-2-1-2-2-4-1\" data-name=\"lesson thumbnail figure\">\n                                <img alt=\"كتاب مفتوح ونص للقراءة\" class=\"h-[126px] w-full object-contain p-3\" data-kid=\"1-2-2-1-2-2-4-1-1\" data-name=\"lesson thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/lessons/reading.svg\"/>\n                            </figure>\n                            <div class=\"flex min-w-0 items-center justify-between gap-4\" data-kid=\"1-2-2-1-2-2-4-2\" data-name=\"lesson video info container\">\n                                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-2-1-2-2-4-2-1\" data-name=\"video details group\">\n                                    <span class=\"flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#f4e3bd] text-[#6f1d1b]\" data-kid=\"1-2-2-1-2-2-4-2-1-1\" data-name=\"play icon container\">\n                                        <i aria-hidden=\"true\" class=\"icon-circle-play text-[20px]\" data-kid=\"1-2-2-1-2-2-4-2-1-1-1\" data-name=\"play icon\">\n                                        </i>\n                                    </span>\n                                    <div class=\"min-w-0\" data-kid=\"1-2-2-1-2-2-4-2-1-2\" data-name=\"video label container\">\n                                        <p class=\"text-[13px] font-semibold text-[#765f4e]\" data-kid=\"1-2-2-1-2-2-4-2-1-2-1\" data-name=\"video label text\">\n                                            فيديو الدرس\n                                        </p>\n                                        <p class=\"truncate text-[15px] font-bold text-[#432818]\" data-kid=\"1-2-2-1-2-2-4-2-1-2-2\" data-name=\"video title text\">\n                                            فيديو القراءة والفهم\n                                        </p>\n                                    </div>\n                                </div>\n                                <a class=\"inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg bg-[#6f1d1b] px-4 text-[13px] font-bold text-white hover:bg-[#55201e] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6f1d1b]\" data-kid=\"1-2-2-1-2-2-4-2-2\" data-name=\"watch video button\" href=\"https://youtu.be/CZbuZRd53tA?si=BWa4M0Bj3q8nOpFL\" rel=\"noreferrer\" target=\"_blank\">\n                                    <span data-kid=\"1-2-2-1-2-2-4-2-2-1\" data-name=\"watch button label\">\n                                        مشاهدة\n                                    </span>\n                                    <i aria-hidden=\"true\" class=\"icon-arrow-up-left text-[16px]\" data-kid=\"1-2-2-1-2-2-4-2-2-2\" data-name=\"external link icon\">\n                                    </i>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-3 divide-y divide-[#ead9b5] border-b border-[#ead9b5]\" data-kid=\"1-2-2-1-3\" data-name=\"additional lessons list container\">\n                    <button aria-expanded=\"false\" class=\"flex min-h-[58px] w-full items-center justify-between gap-4 px-2 text-right text-[16px] font-bold text-[#432818] hover:text-[#6f1d1b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6f1d1b]\" data-kid=\"1-2-2-1-3-1\" data-name=\"lesson accordion button one\" type=\"button\">\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"button label group\">\n                            <i aria-hidden=\"true\" class=\"icon-book-open text-[17px] text-[#99582a]\" data-kid=\"1-2-2-1-3-1-1-1\" data-name=\"book icon\">\n                            </i>\n                            التعبير الكتابي\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-chevron-down text-[19px] text-[#765f4e]\" data-kid=\"1-2-2-1-3-1-2\" data-name=\"chevron icon\">\n                        </i>\n                    </button>\n                    <button aria-expanded=\"false\" class=\"flex min-h-[58px] w-full items-center justify-between gap-4 px-2 text-right text-[16px] font-bold text-[#432818] hover:text-[#6f1d1b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6f1d1b]\" data-kid=\"1-2-2-1-3-2\" data-name=\"lesson accordion button two\" type=\"button\">\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"button label group\">\n                            <i aria-hidden=\"true\" class=\"icon-book-open text-[17px] text-[#99582a]\" data-kid=\"1-2-2-1-3-2-1-1\" data-name=\"book icon\">\n                            </i>\n                            مع عصاي في المدرسة\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-chevron-down text-[19px] text-[#765f4e]\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"chevron icon\">\n                        </i>\n                    </button>\n                    <button aria-expanded=\"false\" class=\"flex min-h-[58px] w-full items-center justify-between gap-4 px-2 text-right text-[16px] font-bold text-[#432818] hover:text-[#6f1d1b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6f1d1b]\" data-kid=\"1-2-2-1-3-3\" data-name=\"lesson accordion button three\" type=\"button\">\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-3-3-1\" data-name=\"button label group\">\n                            <i aria-hidden=\"true\" class=\"icon-book-open text-[17px] text-[#99582a]\" data-kid=\"1-2-2-1-3-3-1-1\" data-name=\"book icon\">\n                            </i>\n                            ماسح الزجاج\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-chevron-down text-[19px] text-[#765f4e]\" data-kid=\"1-2-2-1-3-3-2\" data-name=\"chevron icon\">\n                        </i>\n                    </button>\n                    <button aria-expanded=\"false\" class=\"flex min-h-[58px] w-full items-center justify-between gap-4 px-2 text-right text-[16px] font-bold text-[#432818] hover:text-[#6f1d1b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6f1d1b]\" data-kid=\"1-2-2-1-3-4\" data-name=\"lesson accordion button four\" type=\"button\">\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-3-4-1\" data-name=\"button label group\">\n                            <i aria-hidden=\"true\" class=\"icon-book-open text-[17px] text-[#99582a]\" data-kid=\"1-2-2-1-3-4-1-1\" data-name=\"book icon\">\n                            </i>\n                            جدّتي\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-chevron-down text-[19px] text-[#765f4e]\" data-kid=\"1-2-2-1-3-4-2\" data-name=\"chevron icon\">\n                        </i>\n                    </button>\n                </div>\n            </section>\n            <aside aria-labelledby=\"subjects-heading\" class=\"order-first min-w-0 md:order-none md:sticky md:top-5\" data-kid=\"1-2-2-2\" data-name=\"sidebar area\">\n                <h2 class=\"mb-3 text-[16px] font-extrabold text-[#432818]\" data-kid=\"1-2-2-2-1\" data-name=\"sidebar heading\" id=\"subjects-heading\">\n                    مواد السنة الرابعة\n                </h2>\n                <nav aria-label=\"المواد الدراسية\" class=\"flex gap-2 overflow-x-auto pb-2 md:block md:space-y-1.5 md:overflow-visible md:pb-0\" data-kid=\"1-2-2-2-2\" data-name=\"subjects list navigation\">\n                    <button aria-pressed=\"false\" class=\"inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-[#ead9b5] bg-[#fffdf8] px-3 text-[14px] font-semibold text-[#432818] hover:bg-[#f8f0e4] md:w-full md:border-transparent md:px-3\" data-kid=\"1-2-2-2-2-1\" data-name=\"subject link button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-library text-[17px] text-[#99582a]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"library icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-2-1-2\" data-name=\"subject name text\">\n                            التربية الإسلامية\n                        </span>\n                    </button>\n                    <button aria-pressed=\"true\" class=\"inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg bg-[#6f1d1b] px-3 text-[14px] font-bold text-white md:w-full\" data-kid=\"1-2-2-2-2-2\" data-name=\"subject active link button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-book-text text-[17px]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"book text icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-2-2-2\" data-name=\"subject name text\">\n                            اللغة العربية\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-check mr-auto text-[15px]\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"check icon\">\n                        </i>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-[#ead9b5] bg-[#fffdf8] px-3 text-[14px] font-semibold text-[#432818] hover:bg-[#f8f0e4] md:w-full md:border-transparent md:px-3\" data-kid=\"1-2-2-2-2-3\" data-name=\"subject link button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-calculator text-[17px] text-[#99582a]\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"calculator icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-2-3-2\" data-name=\"subject name text\">\n                            الرياضيات\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-[#ead9b5] bg-[#fffdf8] px-3 text-[14px] font-semibold text-[#432818] hover:bg-[#f8f0e4] md:w-full md:border-transparent md:px-3\" data-kid=\"1-2-2-2-2-4\" data-name=\"subject link button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-history text-[17px] text-[#99582a]\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"history icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-2-4-2\" data-name=\"subject name text\">\n                            التاريخ\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-[#ead9b5] bg-[#fffdf8] px-3 text-[14px] font-semibold text-[#432818] hover:bg-[#f8f0e4] md:w-full md:border-transparent md:px-3\" data-kid=\"1-2-2-2-2-5\" data-name=\"subject link button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-map text-[17px] text-[#99582a]\" data-kid=\"1-2-2-2-2-5-1\" data-name=\"map icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-2-5-2\" data-name=\"subject name text\">\n                            الجغرافيا\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-[#ead9b5] bg-[#fffdf8] px-3 text-[14px] font-semibold text-[#432818] hover:bg-[#f8f0e4] md:w-full md:border-transparent md:px-3\" data-kid=\"1-2-2-2-2-6\" data-name=\"subject link button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-scale text-[17px] text-[#99582a]\" data-kid=\"1-2-2-2-2-6-1\" data-name=\"scale icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-2-6-2\" data-name=\"subject name text\">\n                            التربية المدنية\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-[#ead9b5] bg-[#fffdf8] px-3 text-[14px] font-semibold text-[#432818] hover:bg-[#f8f0e4] md:w-full md:border-transparent md:px-3\" data-kid=\"1-2-2-2-2-7\" data-name=\"subject link button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-flask-conical text-[17px] text-[#99582a]\" data-kid=\"1-2-2-2-2-7-1\" data-name=\"flask icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-2-7-2\" data-name=\"subject name text\">\n                            التربية العلمية\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg border border-[#ead9b5] bg-[#fffdf8] px-3 text-[14px] font-semibold text-[#432818] hover:bg-[#f8f0e4] md:w-full md:border-transparent md:px-3\" data-kid=\"1-2-2-2-2-8\" data-name=\"subject link button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-scroll-text text-[17px] text-[#99582a]\" data-kid=\"1-2-2-2-2-8-1\" data-name=\"scroll text icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-2-8-2\" data-name=\"subject name text\">\n                            المحفوظات\n                        </span>\n                    </button>\n                </nav>\n                <p class=\"mt-3 hidden border-t border-[#ead9b5] pt-3 text-[13px] leading-6 text-[#765f4e] md:block\" data-kid=\"1-2-2-2-3\" data-name=\"sidebar helper text\">\n                    اختر مادة أخرى للانتقال إلى دروسها وملخصاتها.\n                </p>\n            </aside>\n        </div>\n    </main>\n</div>\n",
