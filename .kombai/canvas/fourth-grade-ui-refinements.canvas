    "var_db2051b318c2": {
      "type": "variant",
      "label": "03 · القسم ينشر — الرئيسية",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 8280,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  :root { --background: #fff9ed; --foreground: #432818; --surface: #fffdf8; --surface-muted: #f8eed5; --border: #e9ddc5; --primary: #6f1d1b; --secondary: #bb9457; --accent: #99582a; --muted-foreground: #765f4e; --font-arabic: 'Noto Sans Arabic', sans-serif; }\n</style>\n<div class=\"min-h-screen bg-[var(--background)] font-[var(--font-arabic)] text-[var(--foreground)]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\">\n    <header class=\"border-b border-[var(--border)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex h-[76px] max-w-6xl items-center justify-between gap-5 px-5 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header wrapper\">\n            <a aria-label=\"الصفحة الرئيسية\" class=\"flex min-w-0 items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--primary)]\" data-kid=\"1-1-1-1\" data-name=\"class link container\" href=\"/\">\n                <span aria-hidden=\"true\" class=\"text-[26px] leading-none text-[var(--primary)]\" data-kid=\"1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    <i class=\"icon-graduation-cap\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    </i>\n                </span>\n                <span class=\"flex min-w-0 flex-col\" data-kid=\"1-1-1-1-2\" data-name=\"class title and teacher container\">\n                    <span class=\"truncate text-[16px] font-extrabold leading-6 text-[var(--primary)] sm:text-lg\" data-kid=\"1-1-1-1-2-1\" data-name=\"class name heading\">\n                        قسم السنة الرابعة\n                    </span>\n                    <span class=\"text-[13px] leading-5 text-[var(--muted-foreground)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"teacher name text\">\n                        الأستاذ: عز الدين عويسي\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"القائمة الرئيسية\" class=\"flex shrink-0 items-center gap-1 sm:gap-2\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a aria-current=\"page\" class=\"inline-flex min-h-11 items-center gap-2 rounded-lg bg-[var(--surface-muted)] px-3 text-sm font-bold text-[var(--primary)] sm:px-4\" data-kid=\"1-1-1-2-1\" data-name=\"home link\" href=\"/\">\n                    <span aria-hidden=\"true\" class=\"text-[18px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"home icon container\">\n                        <i class=\"icon-house\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"home icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"home text\">\n                        الرئيسية\n                    </span>\n                </a>\n                <a class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-sm font-semibold text-[var(--foreground)] hover:bg-[var(--surface-muted)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] sm:px-4\" data-kid=\"1-1-1-2-2\" data-name=\"lessons link\" href=\"/lessons\">\n                    <span aria-hidden=\"true\" class=\"text-[18px] text-[var(--primary)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"lessons icon container\">\n                        <i class=\"icon-book-open\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"book open icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"lessons text\">\n                        الدروس\n                    </span>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-6xl px-5 pb-14 pt-9 sm:px-8 sm:pt-12\" data-kid=\"1-2\" data-name=\"main content container\">\n        <section aria-labelledby=\"welcome-title\" class=\"mb-7 border-b border-[var(--border)] pb-7 sm:mb-8 sm:pb-8\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"max-w-3xl\" data-kid=\"1-2-1-1\" data-name=\"hero content wrapper\">\n                <h1 class=\"text-[28px] font-extrabold leading-[1.45] tracking-tight text-[var(--primary)] sm:text-[36px] sm:leading-[1.5]\" data-kid=\"1-2-1-1-1\" data-name=\"welcome heading\" id=\"welcome-title\">\n                    أهلاً بكم في قسم السنة الرابعة\n                </h1>\n                <p class=\"mt-2 max-w-2xl text-[16px] leading-8 text-[var(--muted-foreground)] sm:text-[17px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero description\">\n                    الواجبات والدروس والأنشطة المدرسية لتلاميذ القسم وأولياء أمورهم.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"notices-title\" class=\"mb-8 flex flex-col gap-3 border-b border-[var(--border)] pb-5 sm:mb-10 sm:flex-row sm:items-center sm:gap-6\" data-kid=\"1-2-2\" data-name=\"announcements section\">\n            <h2 class=\"flex shrink-0 items-center gap-2 text-[16px] font-bold text-[var(--foreground)] sm:w-44\" data-kid=\"1-2-2-1\" data-name=\"announcements heading\" id=\"notices-title\">\n                <span aria-hidden=\"true\" class=\"text-[19px] text-[var(--primary)]\" data-kid=\"1-2-2-1-1\" data-name=\"bell icon container\">\n                    <i class=\"icon-bell\" data-kid=\"1-2-2-1-1-1\" data-name=\"bell icon\">\n                    </i>\n                </span>\n                تنبيهات القسم\n            </h2>\n            <p class=\"flex-1 text-[15px] leading-7 text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2\" data-name=\"announcements empty state text\">\n                لا توجد تنبيهات نشطة حالياً.\n            </p>\n        </section>\n        <section aria-labelledby=\"assignments-title\" data-kid=\"1-2-3\" data-name=\"assignments section\">\n            <header class=\"mb-4 flex flex-wrap items-end justify-between gap-3 border-b-2 border-[var(--primary)] pb-4 sm:mb-5\" data-kid=\"1-2-3-1\" data-name=\"assignments section header\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"assignments title wrapper\">\n                    <h2 class=\"text-[23px] font-extrabold leading-9 text-[var(--foreground)] sm:text-[26px]\" data-kid=\"1-2-3-1-1-1\" data-name=\"assignments heading\" id=\"assignments-title\">\n                        الواجبات المنزلية\n                    </h2>\n                    <p class=\"mt-1 text-[14px] leading-6 text-[var(--muted-foreground)]\" data-kid=\"1-2-3-1-1-2\" data-name=\"assignments description\">\n                        تابع المطلوب وآخر أجل للتسليم.\n                    </p>\n                </div>\n                <span class=\"pb-1 text-[14px] font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-2-3-1-2\" data-name=\"assignment count badge\">\n                    واجبان\n                </span>\n            </header>\n            <div class=\"hidden grid-cols-[minmax(0,1fr)_145px_145px_125px_118px] items-center gap-4 px-3 pb-3 text-[13px] font-bold text-[var(--muted-foreground)] md:grid\" data-kid=\"1-2-3-2\" data-name=\"assignment table header\">\n                <span data-kid=\"1-2-3-2-1\" data-name=\"assignment name header\">\n                    اسم الواجب\n                </span>\n                <span class=\"text-center\" data-kid=\"1-2-3-2-2\" data-name=\"assignment date header\">\n                    تاريخ التكليف\n                </span>\n                <span class=\"text-center\" data-kid=\"1-2-3-2-3\" data-name=\"assignment deadline header\">\n                    آخر أجل للتسليم\n                </span>\n                <span class=\"text-center\" data-kid=\"1-2-3-2-4\" data-name=\"assignment status header\">\n                    الحالة\n                </span>\n                <span class=\"text-center\" data-kid=\"1-2-3-2-5\" data-name=\"assignment link header\">\n                    رابط الدرس\n                </span>\n            </div>\n            <ul class=\"divide-y divide-[var(--border)] border-y border-[var(--border)]\" data-kid=\"1-2-3-3\" data-name=\"assignments list container\">\n                <li class=\"grid gap-x-4 gap-y-3 py-5 md:grid-cols-[minmax(0,1fr)_145px_145px_125px_118px] md:items-center md:px-3 md:py-5\" data-kid=\"1-2-3-3-1\" data-name=\"assignment item container\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-3-3-1-1\" data-name=\"assignment item details\">\n                        <h3 class=\"text-[17px] font-bold leading-7 text-[var(--foreground)] sm:text-[18px]\" data-kid=\"1-2-3-3-1-1-1\" data-name=\"assignment item title\">\n                            حفظ الآيات الباقية من سورة العلق\n                        </h3>\n                        <p class=\"mt-1 text-[14px] leading-6 text-[var(--muted-foreground)] md:hidden\" data-kid=\"1-2-3-3-1-1-2\" data-name=\"assignment mobile dates\">\n                            التكليف: ٢٨ سبتمبر ٢٠٢٦ · آخر أجل: ٣٠ سبتمبر ٢٠٢٦\n                        </p>\n                    </div>\n                    <span class=\"hidden text-center text-[14px] text-[var(--muted-foreground)] md:block\" data-kid=\"1-2-3-3-1-2\" data-name=\"assignment item date\">\n                        ٢٨ سبتمبر ٢٠٢٦\n                    </span>\n                    <span class=\"hidden text-center text-[14px] font-semibold text-[var(--foreground)] md:block\" data-kid=\"1-2-3-3-1-3\" data-name=\"assignment item deadline\">\n                        ٣٠ سبتمبر ٢٠٢٦\n                    </span>\n                    <span class=\"inline-flex w-fit items-center rounded-md border border-[#e7c4bd] bg-[#fbefec] px-3 py-1.5 text-[14px] font-bold leading-5 text-[#852d27]\" data-kid=\"1-2-3-3-1-4\" data-name=\"assignment item status badge\">\n                        متأخر\n                    </span>\n                    <a class=\"inline-flex min-h-11 w-fit items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] font-bold text-[var(--primary)] hover:border-[var(--primary)] hover:bg-[var(--surface-muted)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] md:justify-center\" data-kid=\"1-2-3-3-1-5\" data-name=\"assignment item link\" href=\"https://abo-zeyd.github.io/myClass/lessons#islamic-education-surah-al-alaq-item-1d32e32b-image-1\" rel=\"noreferrer\" target=\"_blank\">\n                        <span aria-hidden=\"true\" class=\"text-[17px]\" data-kid=\"1-2-3-3-1-5-1\" data-name=\"arrow up right icon container\">\n                            <i class=\"icon-arrow-up-right\" data-kid=\"1-2-3-3-1-5-1-1\" data-name=\"arrow up right icon\">\n                            </i>\n                        </span>\n                        فتح الدرس\n                    </a>\n                </li>\n                <li class=\"grid gap-x-4 gap-y-3 py-5 md:grid-cols-[minmax(0,1fr)_145px_145px_125px_118px] md:items-center md:px-3 md:py-5\" data-kid=\"1-2-3-3-2\" data-name=\"assignment item container\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-3-3-2-1\" data-name=\"assignment item details\">\n                        <h3 class=\"text-[17px] font-bold leading-7 text-[var(--foreground)] sm:text-[18px]\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"assignment item title\">\n                            حفظ الآيات الثماني الأولى من سورة العلق\n                        </h3>\n                        <p class=\"mt-1 text-[14px] leading-6 text-[var(--muted-foreground)] md:hidden\" data-kid=\"1-2-3-3-2-1-2\" data-name=\"assignment mobile dates\">\n                            التكليف: ٢٧ سبتمبر ٢٠٢٦ · آخر أجل: ٢٨ سبتمبر ٢٠٢٦\n                        </p>\n                    </div>\n                    <span class=\"hidden text-center text-[14px] text-[var(--muted-foreground)] md:block\" data-kid=\"1-2-3-3-2-2\" data-name=\"assignment item date\">\n                        ٢٧ سبتمبر ٢٠٢٦\n                    </span>\n                    <span class=\"hidden text-center text-[14px] font-semibold text-[var(--foreground)] md:block\" data-kid=\"1-2-3-3-2-3\" data-name=\"assignment item deadline\">\n                        ٢٨ سبتمبر ٢٠٢٦\n                    </span>\n                    <span class=\"inline-flex w-fit items-center rounded-md border border-[#e7c4bd] bg-[#fbefec] px-3 py-1.5 text-[14px] font-bold leading-5 text-[#852d27]\" data-kid=\"1-2-3-3-2-4\" data-name=\"assignment item status badge\">\n                        متأخر\n                    </span>\n                    <a class=\"inline-flex min-h-11 w-fit items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 text-[14px] font-bold text-[var(--primary)] hover:border-[var(--primary)] hover:bg-[var(--surface-muted)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)] md:justify-center\" data-kid=\"1-2-3-3-2-5\" data-name=\"assignment item link\" href=\"https://abo-zeyd.github.io/myClass/lessons#islamic-education-surah-al-alaq-item-1d32e32b-image-0\" rel=\"noreferrer\" target=\"_blank\">\n                        <span aria-hidden=\"true\" class=\"text-[17px]\" data-kid=\"1-2-3-3-2-5-1\" data-name=\"arrow up right icon container\">\n                            <i class=\"icon-arrow-up-right\" data-kid=\"1-2-3-3-2-5-1-1\" data-name=\"arrow up right icon\">\n                            </i>\n                        </span>\n                        فتح الدرس\n                    </a>\n                </li>\n            </ul>\n        </section>\n        <div class=\"mt-10 grid gap-9 border-t border-[var(--border)] pt-8 sm:mt-12 sm:grid-cols-2 sm:gap-12\" data-kid=\"1-2-4\" data-name=\"additional resources grid\">\n            <section aria-labelledby=\"activities-title\" data-kid=\"1-2-4-1\" data-name=\"support activities section\">\n                <div class=\"mb-3 flex items-baseline justify-between gap-3\" data-kid=\"1-2-4-1-1\" data-name=\"support activities header\">\n                    <h2 class=\"text-[20px] font-extrabold leading-8 text-[var(--foreground)]\" data-kid=\"1-2-4-1-1-1\" data-name=\"support activities title\" id=\"activities-title\">\n                        أنشطة داعمة\n                    </h2>\n                    <a class=\"text-[14px] font-bold text-[var(--primary)] underline decoration-[var(--secondary)] underline-offset-4 hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]\" data-kid=\"1-2-4-1-1-2\" data-name=\"view lessons link\" href=\"/lessons\">\n                        عرض الدروس\n                    </a>\n                </div>\n                <p class=\"mb-4 text-[14px] leading-6 text-[var(--muted-foreground)]\" data-kid=\"1-2-4-1-2\" data-name=\"support activities description\">\n                    أنشطة إضافية للمراجعة والتدرب.\n                </p>\n                <ul class=\"divide-y divide-[var(--border)] border-t border-[var(--border)]\" data-kid=\"1-2-4-1-3\" data-name=\"support activities list\">\n                    <li class=\"flex items-center justify-between gap-4 py-4\" data-kid=\"1-2-4-1-3-1\" data-name=\"activity item\">\n                        <span class=\"text-[15px] font-semibold leading-7 text-[var(--foreground)]\" data-kid=\"1-2-4-1-3-1-1\" data-name=\"activity item title\">\n                            ملخص وأنشطة درس الأعداد الأصغر من 100 000\n                        </span>\n                        <span class=\"shrink-0 text-[13px] font-bold text-[var(--accent)]\" data-kid=\"1-2-4-1-3-1-2\" data-name=\"activity item badge\">\n                            للتدرب\n                        </span>\n                    </li>\n                    <li class=\"flex items-center justify-between gap-4 py-4\" data-kid=\"1-2-4-1-3-2\" data-name=\"activity item\">\n                        <span class=\"text-[15px] font-semibold leading-7 text-[var(--foreground)]\" data-kid=\"1-2-4-1-3-2-1\" data-name=\"activity item title\">\n                            أنشطة تطبيقية أنواع الكلمة\n                        </span>\n                        <span class=\"shrink-0 text-[13px] font-bold text-[var(--accent)]\" data-kid=\"1-2-4-1-3-2-2\" data-name=\"activity item badge\">\n                            للتدرب\n                        </span>\n                    </li>\n                </ul>\n            </section>\n            <section aria-labelledby=\"posts-title\" class=\"sm:border-r sm:border-[var(--border)] sm:pr-8\" data-kid=\"1-2-4-2\" data-name=\"posts section\">\n                <h2 class=\"text-[20px] font-extrabold leading-8 text-[var(--foreground)]\" data-kid=\"1-2-4-2-1\" data-name=\"posts heading\" id=\"posts-title\">\n                    منشورات القسم\n                </h2>\n                <p class=\"mt-1 text-[14px] leading-6 text-[var(--muted-foreground)]\" data-kid=\"1-2-4-2-2\" data-name=\"posts description\">\n                    التوزيع الزمني والإعلانات المصورة.\n                </p>\n                <div class=\"mt-4 flex min-h-16 items-center border-y border-[var(--border)] py-4\" data-kid=\"1-2-4-2-3\" data-name=\"posts empty state wrapper\">\n                    <p class=\"text-[15px] leading-7 text-[var(--muted-foreground)]\" data-kid=\"1-2-4-2-3-1\" data-name=\"posts empty state text\">\n                        لا توجد صور منشورة حالياً.\n                    </p>\n                </div>\n            </section>\n        </div>\n    </main>\n    <footer class=\"border-t border-[var(--border)] bg-[var(--surface)] px-5 py-5 text-center text-[13px] leading-6 text-[var(--muted-foreground)] sm:px-8\" data-kid=\"1-3\" data-name=\"footer section\">\n        <p data-kid=\"1-3-1\" data-name=\"copyright text\">\n            © ٢٠٢٦ قسم السنة الرابعة — الأستاذ عز الدين عويسي. جميع الحقوق محفوظة.\n        </p>\n    </footer>\n</div>\n",
