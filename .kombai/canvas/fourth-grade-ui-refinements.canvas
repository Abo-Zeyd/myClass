      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n</style>\n<div class=\"min-h-screen bg-[var(--background)] text-[var(--foreground)] [font-family:var(--font-family)]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" lang=\"ar\" style=\"--background:#fff9ed;--foreground:#432818;--surface:#fffdf8;--surface-muted:#ffe6a7;--border:#ead9b5;--primary:#6f1d1b;--secondary:#bb9457;--muted-foreground:#765f4e;--font-family:'Noto Sans Arabic',sans-serif\">\n    <header class=\"border-b border-[var(--border)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1120px] items-center justify-between px-6 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a class=\"group flex min-w-0 flex-col leading-tight no-underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--primary)]\" data-kid=\"1-1-1-1\" data-name=\"site title and author link\" href=\"/\">\n                <span class=\"text-[19px] font-extrabold tracking-tight text-[var(--primary)] sm:text-[21px]\" data-kid=\"1-1-1-1-1\" data-name=\"site title text\">\n                    قسم السنة الرابعة\n                </span>\n                <span class=\"mt-1 text-[13px] font-medium text-[var(--muted-foreground)]\" data-kid=\"1-1-1-1-2\" data-name=\"author name text\">\n                    الأستاذ: عز الدين عويسي\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"flex items-center gap-2 text-[14px] font-semibold sm:gap-6 sm:text-[15px]\" data-kid=\"1-1-1-2\" data-name=\"main navigation\">\n                <a class=\"rounded-md px-3 py-2 text-[var(--foreground)] underline-offset-4 hover:text-[var(--primary)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link for home\" href=\"/\">\n                    الرئيسية\n                </a>\n                <a class=\"rounded-md px-3 py-2 text-[var(--foreground)] underline-offset-4 hover:text-[var(--primary)] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link for lessons\" href=\"/lessons\">\n                    الدروس\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto flex min-h-[calc(100vh-76px)] max-w-[1120px] items-center justify-center px-5 py-12 sm:px-8\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"admin-title\" class=\"w-full max-w-[496px] border border-[var(--border)] bg-[var(--surface)] px-6 py-8 sm:px-11 sm:py-10\" data-kid=\"1-2-1\" data-name=\"login form container\">\n            <div class=\"mb-8 border-b border-[var(--border)] pb-6\" data-kid=\"1-2-1-1\" data-name=\"form header section\">\n                <h1 class=\"text-[26px] font-extrabold leading-[1.5] tracking-tight text-[var(--foreground)] sm:text-[30px]\" data-kid=\"1-2-1-1-1\" data-name=\"login page title\" id=\"admin-title\">\n                    دخول لوحة الإدارة\n                </h1>\n                <p class=\"mt-2 text-[15px] leading-7 text-[var(--muted-foreground)]\" data-kid=\"1-2-1-1-2\" data-name=\"login page description text\">\n                    إدارة الواجبات ومحتوى الدروس\n                </p>\n            </div>\n            <form class=\"grid gap-5\" data-kid=\"1-2-1-2\" data-name=\"login form\">\n                <label class=\"grid gap-2 text-[15px] font-bold leading-6 text-[var(--foreground)]\" data-kid=\"1-2-1-2-1\" data-name=\"password field label\" for=\"admin-password\">\n                    كلمة المرور\n                    <input aria-label=\"كلمة المرور\" autocomplete=\"current-password\" class=\"min-h-[56px] w-full rounded-md border border-[var(--primary)] bg-white px-4 text-[16px] text-[var(--foreground)] outline-hidden ring-4 ring-[var(--primary)]/10 placeholder:text-[var(--muted-foreground)] focus-visible:border-[var(--primary)] focus-visible:ring-4 focus-visible:ring-[var(--primary)]/15\" data-kid=\"1-2-1-2-1-1\" data-name=\"password input field\" id=\"admin-password\" name=\"password\" required=\"\" type=\"password\"/>\n                </label>\n                <button class=\"mt-1 inline-flex min-h-[56px] w-full items-center justify-center rounded-md bg-[var(--primary)] px-6 text-[16px] font-bold text-white transition-colors hover:bg-[#5c1716] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--primary)] active:bg-[#531514]\" data-kid=\"1-2-1-2-2\" data-name=\"login submit button\" type=\"button\">\n                    تسجيل الدخول\n                </button>\n            </form>\n        </section>\n    </main>\n</div>\n",
