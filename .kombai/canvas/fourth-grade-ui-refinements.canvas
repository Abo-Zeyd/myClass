    "var_781acf9b823e": {
      "type": "variant",
      "label": "03 · دروس منشورة — المواد",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
