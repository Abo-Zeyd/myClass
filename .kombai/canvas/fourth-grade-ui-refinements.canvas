    },
    "var_96c3447aabc4": {
      "type": "variant",
      "label": "03 · إدارة منشورات المعلم",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 13800,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[var(--page)] font-[var(--font-ar)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" lang=\"ar\" style=\"--page:#fff9ed;--surface:#fffdf8;--surface-soft:#fff5dc;--line:#ead9b5;--ink:#432818;--muted:#765f4e;--wine:#6f1d1b;--gold:#bb9457;--font-ar:'Noto Sans Arabic',sans-serif\">\n    <header class=\"border-b border-[var(--line)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1160px] items-center justify-between gap-6 px-6\" data-kid=\"1-1-1\" data-name=\"header inner container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"logo and profile info group\">\n                <div class=\"flex size-11 items-center justify-center rounded-xl bg-[var(--page)] text-[var(--wine)]\" data-kid=\"1-1-1-1-1\" data-name=\"logo container\">\n                    <i aria-hidden=\"true\" class=\"icon-graduation-cap text-[24px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    </i>\n                </div>\n                <div class=\"leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"profile information text\">\n                    <p class=\"text-[17px] font-extrabold text-[var(--wine)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"department title\">\n                        قسم السنة الرابعة\n                    </p>\n                    <p class=\"mt-1 text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"teacher name\">\n                        الأستاذ: عز الدين عويسي\n                    </p>\n                </div>\n            </div>\n            <nav aria-label=\"التنقل\" class=\"flex items-center gap-2 text-[14px] font-semibold\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <a class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-4 text-[var(--ink)] hover:bg-[var(--page)]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation home link\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"icon-house text-[18px] text-[var(--wine)]\" data-kid=\"1-1-1-2-1-1\" data-name=\"home icon\">\n                    </i>\n                    الرئيسية\n                </a>\n                <a class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-4 text-[var(--ink)] hover:bg-[var(--page)]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation lessons link\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"icon-book-open text-[18px] text-[var(--wine)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"book open icon\">\n                    </i>\n                    الدروس\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1160px] px-6 pb-14 pt-9\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-8 flex flex-wrap items-end justify-between gap-5 border-b border-[var(--line)] pb-6\" data-kid=\"1-2-1\" data-name=\"page header section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title and description\">\n                <h1 class=\"text-[32px] font-extrabold leading-tight tracking-tight text-[var(--ink)]\" data-kid=\"1-2-1-1-1\" data-name=\"page headline\">\n                    لوحة المحتوى\n                </h1>\n                <p class=\"mt-2 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    إدارة الواجبات ومحتوى الدروس والصفحة الرئيسية.\n                </p>\n            </div>\n            <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[var(--line)] bg-[var(--surface)] px-4 text-[14px] font-bold text-[var(--ink)] hover:bg-[var(--page)]\" data-kid=\"1-2-1-2\" data-name=\"logout button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"icon-log-out text-[18px]\" data-kid=\"1-2-1-2-1\" data-name=\"logout icon\">\n                </i>\n                خروج\n            </button>\n        </div>\n        <div aria-label=\"أقسام لوحة التحكم\" class=\"mb-8 flex flex-wrap gap-1 border-b border-[var(--line)]\" data-kid=\"1-2-2\" data-name=\"tabs navigation list\" role=\"tablist\">\n            <button aria-selected=\"true\" class=\"inline-flex min-h-12 items-center gap-2 border-b-[3px] border-[var(--wine)] px-4 text-[15px] font-bold text-[var(--wine)]\" data-kid=\"1-2-2-1\" data-name=\"notifications and images tab\" role=\"tab\">\n                <i aria-hidden=\"true\" class=\"icon-megaphone text-[18px]\" data-kid=\"1-2-2-1-1\" data-name=\"megaphone icon\">\n                </i>\n                التنبيهات والصور\n            </button>\n            <button aria-selected=\"false\" class=\"inline-flex min-h-12 items-center gap-2 border-b-[3px] border-transparent px-4 text-[15px] font-semibold text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-2-2-2\" data-name=\"support activities tab\" role=\"tab\">\n                <i aria-hidden=\"true\" class=\"icon-check text-[18px]\" data-kid=\"1-2-2-2-1\" data-name=\"checkmark icon\">\n                </i>\n                الأنشطة الداعمة\n            </button>\n            <button aria-selected=\"false\" class=\"inline-flex min-h-12 items-center gap-2 border-b-[3px] border-transparent px-4 text-[15px] font-semibold text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-2-2-3\" data-name=\"assignments tab\" role=\"tab\">\n                <i aria-hidden=\"true\" class=\"icon-clipboard-list text-[18px]\" data-kid=\"1-2-2-3-1\" data-name=\"clipboard list icon\">\n                </i>\n                الواجبات\n            </button>\n            <button aria-selected=\"false\" class=\"inline-flex min-h-12 items-center gap-2 border-b-[3px] border-transparent px-4 text-[15px] font-semibold text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-2-2-4\" data-name=\"lessons tab\" role=\"tab\">\n                <i aria-hidden=\"true\" class=\"icon-book-open text-[18px]\" data-kid=\"1-2-2-4-1\" data-name=\"book open icon\">\n                </i>\n                الدروس\n            </button>\n        </div>\n        <div class=\"mb-7 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-[#b9d5bc] bg-[#f0f7ef] px-5 py-4 text-[14px] leading-6 text-[#305a36]\" data-kid=\"1-2-3\" data-name=\"status notification banner\" role=\"status\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1\" data-name=\"status message group\">\n                <i aria-hidden=\"true\" class=\"icon-circle-check text-[20px]\" data-kid=\"1-2-3-1-1\" data-name=\"circle check icon\">\n                </i>\n                <span class=\"font-semibold\" data-kid=\"1-2-3-1-2\" data-name=\"status message text\">\n                    تم حفظ التنبيهات.\n                </span>\n            </div>\n            <span class=\"text-[13px] text-[#46694a]\" data-kid=\"1-2-3-2\" data-name=\"banner helper text\">\n                الحفظ يسجّل التعديلات؛ خيار «نشر» يحدد ظهور المحتوى للزوار.\n            </span>\n        </div>\n        <section aria-labelledby=\"announcements-title\" class=\"pb-8\" data-kid=\"1-2-4\" data-name=\"announcements section\">\n            <header class=\"mb-5 flex flex-wrap items-center justify-between gap-5\" data-kid=\"1-2-4-1\" data-name=\"announcements header\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"announcements title group\">\n                    <h2 class=\"flex items-center gap-2 text-[22px] font-bold text-[var(--ink)]\" data-kid=\"1-2-4-1-1-1\" data-name=\"announcements section title\" id=\"announcements-title\">\n                        <i aria-hidden=\"true\" class=\"icon-bell-ring text-[21px] text-[var(--wine)]\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"bell ring icon\">\n                        </i>\n                        شريط التنبيهات\n                    </h2>\n                    <p class=\"mt-1 text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-4-1-1-2\" data-name=\"announcements helper text\">\n                        تظهر التنبيهات المفعّلة فوق الواجبات المنزلية.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-2-4-1-2\" data-name=\"announcements action buttons\">\n                    <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[var(--line)] bg-[var(--surface)] px-4 text-[14px] font-bold text-[var(--ink)] hover:bg-[var(--page)]\" data-kid=\"1-2-4-1-2-1\" data-name=\"add announcement button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-plus text-[19px]\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"plus icon\">\n                        </i>\n                        إضافة تنبيه\n                    </button>\n                    <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg bg-[var(--wine)] px-5 text-[14px] font-bold text-white hover:bg-[#571615]\" data-kid=\"1-2-4-1-2-2\" data-name=\"save announcements button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-save text-[18px]\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"save icon\">\n                        </i>\n                        حفظ التنبيهات\n                    </button>\n                </div>\n            </header>\n            <div class=\"border-y border-[var(--line)] bg-[var(--surface)] px-5 py-5 sm:px-6\" data-kid=\"1-2-4-2\" data-name=\"announcements editor row\">\n                <div class=\"grid items-start gap-5 md:grid-cols-[minmax(0,1fr)_170px_48px] md:items-center\" data-kid=\"1-2-4-2-1\" data-name=\"announcement fields grid\">\n                    <label class=\"grid gap-2 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-4-2-1-1\" data-name=\"announcement text label\">\n                        نص التنبيه\n                        <textarea class=\"w-full resize-y rounded-lg border border-[var(--line)] bg-[var(--page)] px-4 py-3 text-[15px] leading-7 text-[var(--ink)] placeholder:text-[#8b7969] outline-none focus:border-[var(--wine)] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-4-2-1-1-1\" data-name=\"announcement text area\" maxlength=\"1000\" placeholder=\"اكتب نص التنبيه هنا\" rows=\"2\"></textarea>\n                    </label>\n                    <label class=\"flex min-h-12 items-center gap-3 rounded-lg bg-[var(--surface-soft)] px-4 text-[14px] font-bold text-[var(--ink)]\" data-kid=\"1-2-4-2-1-2\" data-name=\"publish toggle checkbox group\">\n                        <input checked=\"\" class=\"size-5 accent-[#6f1d1b]\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"publish checkbox input\" type=\"checkbox\"/>\n                        <span data-kid=\"1-2-4-2-1-2-2\" data-name=\"publish label text\">\n                            نشر\n                        </span>\n                        <span class=\"mr-auto rounded-full bg-[#e6f1e5] px-2.5 py-1 text-[12px] font-bold text-[#315b37]\" data-kid=\"1-2-4-2-1-2-3\" data-name=\"active status badge\">\n                            مفعّل\n                        </span>\n                    </label>\n                    <button aria-label=\"حذف التنبيه\" class=\"flex size-11 items-center justify-center rounded-lg text-[#8e2c27] hover:bg-[#fbefed]\" data-kid=\"1-2-4-2-1-3\" data-name=\"delete announcement button\" title=\"حذف التنبيه\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-trash-2 text-[19px]\" data-kid=\"1-2-4-2-1-3-1\" data-name=\"trash icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"slides-title\" class=\"border-t border-[var(--line)] pt-7\" data-kid=\"1-2-5\" data-name=\"slides section\">\n            <header class=\"mb-5 flex flex-wrap items-center justify-between gap-5\" data-kid=\"1-2-5-1\" data-name=\"slides header\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"slides title group\">\n                    <h2 class=\"flex items-center gap-2 text-[22px] font-bold text-[var(--ink)]\" data-kid=\"1-2-5-1-1-1\" data-name=\"slides section title\" id=\"slides-title\">\n                        <i aria-hidden=\"true\" class=\"icon-images text-[21px] text-[var(--wine)]\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"images icon\">\n                        </i>\n                        صور منشورات القسم\n                    </h2>\n                    <p class=\"mt-1 max-w-2xl text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-5-1-1-2\" data-name=\"slides helper text\">\n                        أضف رابط مشاركة لصورة من Google Drive، واجعل الملف متاحاً لمن لديه الرابط.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-2-5-1-2\" data-name=\"slides action buttons\">\n                    <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[var(--line)] bg-[var(--surface)] px-4 text-[14px] font-bold text-[var(--ink)] hover:bg-[var(--page)]\" data-kid=\"1-2-5-1-2-1\" data-name=\"add slide button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-plus text-[19px]\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"plus icon\">\n                        </i>\n                        إضافة صورة\n                    </button>\n                    <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg bg-[var(--wine)] px-5 text-[14px] font-bold text-white hover:bg-[#571615]\" data-kid=\"1-2-5-1-2-2\" data-name=\"save slides button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-save text-[18px]\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"save icon\">\n                        </i>\n                        حفظ الصور\n                    </button>\n                </div>\n            </header>\n            <div class=\"border-y border-[var(--line)] bg-[var(--surface)] px-5 py-5 sm:px-6\" data-kid=\"1-2-5-2\" data-name=\"slide editor row\">\n                <div class=\"grid gap-5 md:grid-cols-[88px_minmax(0,1fr)_145px_48px] md:items-end\" data-kid=\"1-2-5-2-1\" data-name=\"slide fields grid\">\n                    <div class=\"flex size-[88px] items-center justify-center rounded-lg bg-[var(--surface-soft)] text-[var(--gold)]\" data-kid=\"1-2-5-2-1-1\" data-name=\"slide image preview placeholder\">\n                        <i aria-hidden=\"true\" class=\"icon-image-plus text-[30px]\" data-kid=\"1-2-5-2-1-1-1\" data-name=\"image plus icon\">\n                        </i>\n                    </div>\n                    <div class=\"grid gap-4 sm:grid-cols-2\" data-kid=\"1-2-5-2-1-2\" data-name=\"slide input fields group\">\n                        <label class=\"grid gap-2 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"slide title label\">\n                            عنوان الصورة\n                            <input class=\"min-h-12 rounded-lg border border-[var(--line)] bg-[var(--page)] px-4 text-[15px] font-medium text-[var(--ink)] outline-none focus:border-[var(--wine)] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-5-2-1-2-1-1\" data-name=\"slide title input\" value=\"صورة جديدة\"/>\n                        </label>\n                        <label class=\"grid gap-2 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-5-2-1-2-2\" data-name=\"slide drive url label\">\n                            رابط مشاركة Google Drive\n                            <input class=\"min-h-12 min-w-0 rounded-lg border border-[var(--line)] bg-[var(--page)] px-4 text-[14px] text-[var(--ink)] placeholder:text-[#8b7969] outline-none focus:border-[var(--wine)] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-5-2-1-2-2-1\" data-name=\"slide drive url input\" placeholder=\"https://drive.google.com/file/d/.../view\" type=\"url\"/>\n                        </label>\n                    </div>\n                    <label class=\"flex min-h-12 items-center gap-3 rounded-lg bg-[var(--surface-soft)] px-4 text-[14px] font-bold text-[var(--ink)]\" data-kid=\"1-2-5-2-1-3\" data-name=\"publish toggle checkbox group\">\n                        <input checked=\"\" class=\"size-5 accent-[#6f1d1b]\" data-kid=\"1-2-5-2-1-3-1\" data-name=\"publish checkbox input\" type=\"checkbox\"/>\n                        <span data-kid=\"1-2-5-2-1-3-2\" data-name=\"publish label text\">\n                            نشر\n                        </span>\n                        <span class=\"mr-auto rounded-full bg-[#e6f1e5] px-2.5 py-1 text-[12px] font-bold text-[#315b37]\" data-kid=\"1-2-5-2-1-3-3\" data-name=\"active status badge\">\n                            مفعّل\n                        </span>\n                    </label>\n                    <button aria-label=\"حذف الصورة\" class=\"flex size-11 items-center justify-center rounded-lg text-[#8e2c27] hover:bg-[#fbefed]\" data-kid=\"1-2-5-2-1-4\" data-name=\"delete slide button\" title=\"حذف الصورة\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-trash-2 text-[19px]\" data-kid=\"1-2-5-2-1-4-1\" data-name=\"trash icon\">\n                        </i>\n                    </button>\n                </div>\n                <p class=\"mt-4 mr-[108px] text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-5-2-2\" data-name=\"slides helper instruction text\">\n                    فعّل «نشر» لإظهار الصورة في منشورات القسم، ثم احفظ التغييرات.\n                </p>\n            </div>\n        </section>\n        <footer class=\"mt-10 border-t border-[var(--line)] pt-5 text-[13px] text-[var(--muted)]\" data-kid=\"1-2-6\" data-name=\"footer\">\n            <p data-kid=\"1-2-6-1\" data-name=\"footer copyright text\">\n                قسم السنة الرابعة · الأستاذ عز الدين عويسي\n            </p>\n        </footer>\n    </main>\n</div>\n",
