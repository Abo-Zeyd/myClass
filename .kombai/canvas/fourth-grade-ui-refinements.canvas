      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n</style>\n<div class=\"min-h-screen bg-[var(--background)] text-[var(--foreground)] font-sans\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" style=\"--background:#fff9ed;--foreground:#432818;--surface:#fffdf8;--surface-muted:#ffe6a7;--border:#ead9b5;--primary:#6f1d1b;--secondary:#bb9457;--accent:#99582a;--muted:#765f4e;--late:#9f3327;--late-soft:#fbe8e4;font-family:'Noto Sans Arabic',sans-serif;\">\n    <header class=\"border-b border-[var(--border)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1200px] items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"header navigation layout\">\n            <a class=\"flex items-center gap-3 text-right no-underline\" data-kid=\"1-1-1-1\" data-name=\"site logo and teacher branding\" href=\"/\">\n                <span aria-hidden=\"true\" class=\"flex size-11 items-center justify-center rounded-xl bg-[#f5eee2] text-[var(--primary)] text-2xl\" data-kid=\"1-1-1-1-1\" data-name=\"graduation cap icon container\">\n                    <i class=\"icon-graduation-cap\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    </i>\n                </span>\n                <span class=\"flex flex-col leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"site branding text\">\n                    <strong class=\"text-lg font-extrabold text-[var(--primary)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"site title\">\n                        قسم السنة الرابعة\n                    </strong>\n                    <span class=\"mt-1 text-sm font-medium text-[var(--muted)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"teacher name\">\n                        الأستاذ: عز الدين عويسي\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"flex h-full items-center gap-2 text-base font-bold\" data-kid=\"1-1-1-2\" data-name=\"primary navigation bar\">\n                <a aria-current=\"page\" class=\"flex h-full items-center gap-2 border-b-[3px] border-[var(--primary)] px-4 text-[var(--primary)] no-underline\" data-kid=\"1-1-1-2-1\" data-name=\"home navigation link\" href=\"/\">\n                    <i aria-hidden=\"true\" class=\"icon-house text-lg\" data-kid=\"1-1-1-2-1-1\" data-name=\"home icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"home label\">\n                        الرئيسية\n                    </span>\n                </a>\n                <a class=\"flex h-full items-center gap-2 border-b-[3px] border-transparent px-4 text-[var(--foreground)] no-underline hover:text-[var(--primary)]\" data-kid=\"1-1-1-2-2\" data-name=\"lessons navigation link\" href=\"/lessons\">\n                    <i aria-hidden=\"true\" class=\"icon-book-open text-lg\" data-kid=\"1-1-1-2-2-1\" data-name=\"lessons book icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"lessons label\">\n                        الدروس\n                    </span>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1120px] px-6 pb-14 pt-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"welcome-title\" class=\"mb-8 border-b border-[var(--border)] pb-7\" data-kid=\"1-2-1\" data-name=\"welcome section\">\n            <h1 class=\"m-0 text-3xl font-extrabold leading-[1.45] tracking-tight text-[var(--primary)]\" data-kid=\"1-2-1-1\" data-name=\"welcome headline\" id=\"welcome-title\">\n                أهلاً بكم في قسم السنة الرابعة\n            </h1>\n            <p class=\"mb-0 mt-2 max-w-3xl text-base leading-8 text-[var(--muted)]\" data-kid=\"1-2-1-2\" data-name=\"welcome description\">\n                الدروس والواجبات والأنشطة المدرسية للتلاميذ وأولياء الأمور.\n            </p>\n        </section>\n        <section aria-labelledby=\"assignments-title\" class=\"mb-9 border-b border-[var(--border)] pb-9\" data-kid=\"1-2-2\" data-name=\"assignments section\">\n            <div class=\"mb-5 flex flex-wrap items-end justify-between gap-3\" data-kid=\"1-2-2-1\" data-name=\"assignments section header\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"assignments title and description\">\n                    <h2 class=\"m-0 text-2xl font-extrabold leading-tight text-[var(--foreground)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"assignments section title\" id=\"assignments-title\">\n                        الواجبات المنزلية\n                    </h2>\n                    <p class=\"mb-0 mt-1 text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-2-2-1-1-2\" data-name=\"assignments sub-description\">\n                        تحقّق من موعد التسليم وافتح ملف الواجب.\n                    </p>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-[minmax(0,1fr)_170px_126px] gap-5 border-b border-[var(--border)] px-4 pb-3 text-sm font-bold text-[var(--muted)]\" data-kid=\"1-2-2-2\" data-name=\"assignments table header\">\n                <span data-kid=\"1-2-2-2-1\" data-name=\"assignments status header\">\n                    الواجب والحالة\n                </span>\n                <span class=\"text-center\" data-kid=\"1-2-2-2-2\" data-name=\"due date header\">\n                    آخر أجل للتسليم\n                </span>\n                <span class=\"text-center\" data-kid=\"1-2-2-2-3\" data-name=\"assigned date header\">\n                    تاريخ التكليف\n                </span>\n            </div>\n            <ul class=\"m-0 list-none p-0\" data-kid=\"1-2-2-3\" data-name=\"assignments list\">\n                <li class=\"grid grid-cols-[minmax(0,1fr)_170px_126px] items-center gap-5 border-b border-[var(--border)] px-4 py-5\" data-kid=\"1-2-2-3-1\" data-name=\"assignment entry\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-2-3-1-1\" data-name=\"assignment details\">\n                        <div class=\"mb-2 flex items-center gap-2\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"assignment status indicator\">\n                            <span class=\"inline-flex items-center gap-1.5 rounded-full bg-[var(--late-soft)] px-3 py-1 text-sm font-bold text-[var(--late)]\" data-kid=\"1-2-2-3-1-1-1-1\" data-name=\"status pill\">\n                                <span class=\"size-2 rounded-full bg-[var(--late)]\" data-kid=\"1-2-2-3-1-1-1-1-1\" data-name=\"status dot icon\">\n                                </span>\n                                متأخر\n                            </span>\n                        </div>\n                        <p class=\"m-0 text-lg font-bold leading-7 text-[var(--foreground)]\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"assignment title\">\n                            حفظ الآيات الباقية من سورة العلق\n                        </p>\n                        <a class=\"mt-2 inline-flex min-h-11 items-center gap-2 text-base font-bold text-[var(--primary)] underline decoration-[var(--border)] underline-offset-4 hover:decoration-[var(--primary)]\" data-kid=\"1-2-2-3-1-1-3\" data-name=\"assignment open link\" href=\"https://abo-zeyd.github.io/myClass/lessons#islamic-education-surah-al-alaq-item-1d32e32b-image-1\">\n                            <span data-kid=\"1-2-2-3-1-1-3-1\" data-name=\"assignment open label\">\n                                فتح الواجب\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-external-link text-base\" data-kid=\"1-2-2-3-1-1-3-2\" data-name=\"external link icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"text-center\" data-kid=\"1-2-2-3-1-2\" data-name=\"assignment due date\">\n                        <span class=\"mb-1 block text-sm font-medium text-[var(--muted)]\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"due date label\">\n                            موعد التسليم\n                        </span>\n                        <strong class=\"text-base font-extrabold text-[var(--late)]\" data-kid=\"1-2-2-3-1-2-2\" data-name=\"due date value\">\n                            ٣٠ سبتمبر ٢٠٢٦\n                        </strong>\n                    </div>\n                    <div class=\"text-center\" data-kid=\"1-2-2-3-1-3\" data-name=\"assignment assigned date\">\n                        <span class=\"mb-1 block text-sm font-medium text-[var(--muted)]\" data-kid=\"1-2-2-3-1-3-1\" data-name=\"assigned date label\">\n                            كُلّف به\n                        </span>\n                        <time class=\"text-sm font-semibold text-[var(--foreground)]\" data-kid=\"1-2-2-3-1-3-2\" data-name=\"assigned date value\" datetime=\"2026-09-28\">\n                            ٢٨ سبتمبر ٢٠٢٦\n                        </time>\n                    </div>\n                </li>\n                <li class=\"grid grid-cols-[minmax(0,1fr)_170px_126px] items-center gap-5 px-4 py-5\" data-kid=\"1-2-2-3-2\" data-name=\"second assignment entry\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-2-3-2-1\" data-name=\"assignment details\">\n                        <div class=\"mb-2 flex items-center gap-2\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"assignment status indicator\">\n                            <span class=\"inline-flex items-center gap-1.5 rounded-full bg-[var(--late-soft)] px-3 py-1 text-sm font-bold text-[var(--late)]\" data-kid=\"1-2-2-3-2-1-1-1\" data-name=\"status pill\">\n                                <span class=\"size-2 rounded-full bg-[var(--late)]\" data-kid=\"1-2-2-3-2-1-1-1-1\" data-name=\"status dot icon\">\n                                </span>\n                                متأخر\n                            </span>\n                        </div>\n                        <p class=\"m-0 text-lg font-bold leading-7 text-[var(--foreground)]\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"assignment title\">\n                            حفظ الآيات الثماني الأولى من سورة العلق\n                        </p>\n                        <a class=\"mt-2 inline-flex min-h-11 items-center gap-2 text-base font-bold text-[var(--primary)] underline decoration-[var(--border)] underline-offset-4 hover:decoration-[var(--primary)]\" data-kid=\"1-2-2-3-2-1-3\" data-name=\"assignment open link\" href=\"https://abo-zeyd.github.io/myClass/lessons#islamic-education-surah-al-alaq-item-1d32e32b-image-0\">\n                            <span data-kid=\"1-2-2-3-2-1-3-1\" data-name=\"assignment open label\">\n                                فتح الواجب\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-external-link text-base\" data-kid=\"1-2-2-3-2-1-3-2\" data-name=\"external link icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"text-center\" data-kid=\"1-2-2-3-2-2\" data-name=\"assignment due date\">\n                        <span class=\"mb-1 block text-sm font-medium text-[var(--muted)]\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"due date label\">\n                            موعد التسليم\n                        </span>\n                        <strong class=\"text-base font-extrabold text-[var(--late)]\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"due date value\">\n                            ٢٨ سبتمبر ٢٠٢٦\n                        </strong>\n                    </div>\n                    <div class=\"text-center\" data-kid=\"1-2-2-3-2-3\" data-name=\"assignment assigned date\">\n                        <span class=\"mb-1 block text-sm font-medium text-[var(--muted)]\" data-kid=\"1-2-2-3-2-3-1\" data-name=\"assigned date label\">\n                            كُلّف به\n                        </span>\n                        <time class=\"text-sm font-semibold text-[var(--foreground)]\" data-kid=\"1-2-2-3-2-3-2\" data-name=\"assigned date value\" datetime=\"2026-09-27\">\n                            ٢٧ سبتمبر ٢٠٢٦\n                        </time>\n                    </div>\n                </li>\n            </ul>\n        </section>\n        <div class=\"grid grid-cols-12 items-start gap-x-10 gap-y-8\" data-kid=\"1-2-3\" data-name=\"activities and posts container\">\n            <section aria-labelledby=\"activities-title\" class=\"col-span-8\" data-kid=\"1-2-3-1\" data-name=\"activities section\">\n                <h2 class=\"m-0 text-xl font-extrabold text-[var(--foreground)]\" data-kid=\"1-2-3-1-1\" data-name=\"activities section title\" id=\"activities-title\">\n                    أنشطة داعمة\n                </h2>\n                <p class=\"mb-3 mt-1 text-sm text-[var(--muted)]\" data-kid=\"1-2-3-1-2\" data-name=\"activities section description\">\n                    للمراجعة والتدرّب الإضافي.\n                </p>\n                <ul class=\"m-0 list-none divide-y divide-[var(--border)] p-0\" data-kid=\"1-2-3-1-3\" data-name=\"activities list\">\n                    <li class=\"flex min-h-14 items-center justify-between gap-4 py-3\" data-kid=\"1-2-3-1-3-1\" data-name=\"activity item\">\n                        <p class=\"m-0 text-base font-semibold leading-7 text-[var(--foreground)]\" data-kid=\"1-2-3-1-3-1-1\" data-name=\"activity item title\">\n                            ملخص وأنشطة درس الأعداد الأصغر من 100 000\n                        </p>\n                        <a class=\"inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-bold text-[var(--primary)] underline underline-offset-4\" data-kid=\"1-2-3-1-3-1-2\" data-name=\"activity link\" href=\"/lessons\">\n                            عرض النشاط\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-left text-base\" data-kid=\"1-2-3-1-3-1-2-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                    </li>\n                    <li class=\"flex min-h-14 items-center justify-between gap-4 py-3\" data-kid=\"1-2-3-1-3-2\" data-name=\"activity item\">\n                        <p class=\"m-0 text-base font-semibold leading-7 text-[var(--foreground)]\" data-kid=\"1-2-3-1-3-2-1\" data-name=\"activity item title\">\n                            أنشطة تطبيقية: أنواع الكلمة\n                        </p>\n                        <a class=\"inline-flex min-h-11 shrink-0 items-center gap-2 text-sm font-bold text-[var(--primary)] underline underline-offset-4\" data-kid=\"1-2-3-1-3-2-2\" data-name=\"activity link\" href=\"/lessons\">\n                            عرض النشاط\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-left text-base\" data-kid=\"1-2-3-1-3-2-2-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                    </li>\n                </ul>\n            </section>\n            <section aria-labelledby=\"posts-title\" class=\"col-span-4 border-r border-[var(--border)] pr-6\" data-kid=\"1-2-3-2\" data-name=\"posts section\">\n                <h2 class=\"m-0 text-xl font-extrabold text-[var(--foreground)]\" data-kid=\"1-2-3-2-1\" data-name=\"posts section title\" id=\"posts-title\">\n                    منشورات القسم\n                </h2>\n                <p class=\"mb-0 mt-3 text-base leading-7 text-[var(--muted)]\" data-kid=\"1-2-3-2-2\" data-name=\"posts empty message\">\n                    لا توجد صور منشورة حالياً.\n                </p>\n            </section>\n        </div>\n    </main>\n    <footer class=\"border-t border-[var(--border)] bg-[var(--surface)] px-6 py-5 text-center text-sm leading-6 text-[var(--muted)]\" data-kid=\"1-3\" data-name=\"footer container\">\n        <p class=\"m-0\" data-kid=\"1-3-1\" data-name=\"copyright text\">\n            © ٢٠٢٦ قسم السنة الرابعة — الأستاذ عز الدين عويسي. جميع الحقوق محفوظة.\n        </p>\n    </footer>\n</div>\n",
