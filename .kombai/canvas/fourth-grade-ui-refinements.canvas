      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css');\n:root{--paper:#fff9ed;--surface:#fffdf8;--surface-soft:#fff5df;--ink:#432818;--muted:#765f4e;--line:#ead9b5;--wine:#6f1d1b;--gold:#bb9457;--gold-soft:#f3e6ca;--ok-bg:#edf5e9;--ok-ink:#345a2e;--late-bg:#fbefee;--late-ink:#8c2e26;--arabic:'Noto Sans Arabic',sans-serif;}\n</style>\n<div class=\"min-h-screen bg-[var(--paper)] font-[var(--arabic)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\">\n    <header class=\"border-b border-[var(--line)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex h-[74px] max-w-[1160px] items-center justify-between gap-6 px-6\" data-kid=\"1-1-1\" data-name=\"header inner container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand identity container\">\n                <span aria-hidden=\"true\" class=\"flex size-11 items-center justify-center rounded-xl bg-[var(--gold-soft)] text-[var(--wine)]\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\">\n                    <i class=\"fa-solid fa-graduation-cap text-[20px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    </i>\n                </span>\n                <div class=\"leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"brand information container\">\n                    <a class=\"text-[17px] font-extrabold text-[var(--wine)] no-underline\" data-kid=\"1-1-1-1-2-1\" data-name=\"class name link\" href=\"#\">\n                        قسم السنة الرابعة\n                    </a>\n                    <p class=\"mt-1 text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"teacher name text\">\n                        الأستاذ: عز الدين عويسي\n                    </p>\n                </div>\n            </div>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"flex items-center gap-2 text-[15px] font-semibold\" data-kid=\"1-1-1-2\" data-name=\"main navigation\">\n                <a class=\"flex min-h-11 items-center gap-2 rounded-lg px-4 text-[var(--muted)] no-underline hover:bg-[var(--surface-soft)] hover:text-[var(--wine)]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation home link\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"fa-solid fa-house text-[15px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"home icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"home label\">\n                        الرئيسية\n                    </span>\n                </a>\n                <a class=\"flex min-h-11 items-center gap-2 rounded-lg px-4 text-[var(--muted)] no-underline hover:bg-[var(--surface-soft)] hover:text-[var(--wine)]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation lessons link\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"fa-solid fa-book-open text-[16px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"lessons icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"lessons label\">\n                        الدروس\n                    </span>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[1120px] px-6 pb-16 pt-8\" data-kid=\"1-2\" data-name=\"main content container\">\n        <div class=\"mb-7 flex flex-wrap items-end justify-between gap-5 border-b border-[var(--line)] pb-6\" data-kid=\"1-2-1\" data-name=\"page header section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title and description container\">\n                <h1 class=\"text-[30px] font-extrabold leading-tight tracking-tight text-[var(--ink)]\" data-kid=\"1-2-1-1-1\" data-name=\"page title text\">\n                    لوحة المحتوى\n                </h1>\n                <p class=\"mt-2 text-[15px] font-medium text-[var(--muted)]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    إدارة الواجبات ومحتوى الدروس\n                </p>\n            </div>\n            <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[var(--line)] bg-[var(--surface)] px-4 text-[14px] font-bold text-[var(--ink)] hover:bg-[var(--surface-soft)]\" data-kid=\"1-2-1-2\" data-name=\"logout button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"fa-solid fa-arrow-right-from-bracket text-[15px] text-[var(--muted)]\" data-kid=\"1-2-1-2-1\" data-name=\"logout icon\">\n                </i>\n                خروج\n            </button>\n        </div>\n        <div aria-label=\"أقسام لوحة التحكم\" class=\"mb-8 flex flex-wrap items-center gap-1 border-b border-[var(--line)]\" data-kid=\"1-2-2\" data-name=\"tab navigation bar\" role=\"tablist\">\n            <button aria-selected=\"false\" class=\"inline-flex min-h-12 items-center gap-2 border-b-2 border-transparent px-5 text-[15px] font-semibold text-[var(--muted)] hover:text-[var(--wine)]\" data-kid=\"1-2-2-1\" data-name=\"notifications tab button\" role=\"tab\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"fa-regular fa-bell text-[16px]\" data-kid=\"1-2-2-1-1\" data-name=\"notifications icon\">\n                </i>\n                التنبيهات والصور\n            </button>\n            <button aria-selected=\"false\" class=\"inline-flex min-h-12 items-center gap-2 border-b-2 border-transparent px-5 text-[15px] font-semibold text-[var(--muted)] hover:text-[var(--wine)]\" data-kid=\"1-2-2-2\" data-name=\"support activities tab button\" role=\"tab\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"fa-regular fa-circle-check text-[16px]\" data-kid=\"1-2-2-2-1\" data-name=\"support activities icon\">\n                </i>\n                الأنشطة الداعمة\n            </button>\n            <button aria-selected=\"true\" class=\"inline-flex min-h-12 items-center gap-2 border-b-2 border-[var(--wine)] px-5 text-[15px] font-bold text-[var(--wine)]\" data-kid=\"1-2-2-3\" data-name=\"assignments tab button\" role=\"tab\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"fa-regular fa-clipboard text-[16px]\" data-kid=\"1-2-2-3-1\" data-name=\"assignments icon\">\n                </i>\n                الواجبات\n            </button>\n            <button aria-selected=\"false\" class=\"inline-flex min-h-12 items-center gap-2 border-b-2 border-transparent px-5 text-[15px] font-semibold text-[var(--muted)] hover:text-[var(--wine)]\" data-kid=\"1-2-2-4\" data-name=\"lessons tab button\" role=\"tab\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"fa-solid fa-book-open text-[16px]\" data-kid=\"1-2-2-4-1\" data-name=\"lessons icon\">\n                </i>\n                الدروس\n            </button>\n        </div>\n        <section aria-label=\"إدارة الواجبات\" data-kid=\"1-2-3\" data-name=\"assignments management panel\" role=\"tabpanel\">\n            <div class=\"mb-5 flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-2-3-1\" data-name=\"assignments actions header\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"assignments title section\">\n                    <h2 class=\"text-[21px] font-bold leading-tight text-[var(--ink)]\" data-kid=\"1-2-3-1-1-1\" data-name=\"assignments section title\">\n                        الواجبات المنزلية\n                    </h2>\n                    <p class=\"mt-1 text-[14px] text-[var(--muted)]\" data-kid=\"1-2-3-1-1-2\" data-name=\"assignments description text\">\n                        تابع المواعيد وحالة الإنجاز، ثم احفظ التغييرات.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-2-3-1-2\" data-name=\"action buttons container\">\n                    <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[var(--line)] bg-[var(--surface)] px-4 text-[14px] font-bold text-[var(--ink)] hover:bg-[var(--surface-soft)]\" data-kid=\"1-2-3-1-2-1\" data-name=\"add assignment button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"fa-solid fa-plus text-[14px] text-[var(--wine)]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"add assignment icon\">\n                        </i>\n                        إضافة واجب\n                    </button>\n                    <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg bg-[var(--wine)] px-5 text-[14px] font-bold text-white hover:bg-[#57201c]\" data-kid=\"1-2-3-1-2-2\" data-name=\"save assignments button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"fa-regular fa-floppy-disk text-[15px]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"save icon\">\n                        </i>\n                        حفظ الواجبات\n                    </button>\n                </div>\n            </div>\n            <p class=\"mb-5 flex min-h-11 items-center gap-2 rounded-lg border border-[#d8e7d2] bg-[var(--ok-bg)] px-4 py-2 text-[14px] font-semibold text-[var(--ok-ink)]\" data-kid=\"1-2-3-2\" data-name=\"success notification message\" role=\"status\">\n                <i aria-hidden=\"true\" class=\"fa-solid fa-circle-check text-[16px]\" data-kid=\"1-2-3-2-1\" data-name=\"check icon\">\n                </i>\n                تم حفظ الواجبات في Supabase.\n            </p>\n            <div class=\"overflow-hidden rounded-xl border border-[var(--line)] bg-[var(--surface)]\" data-kid=\"1-2-3-3\" data-name=\"assignments list table container\">\n                <div class=\"hidden grid-cols-[minmax(0,1fr)_160px_160px_160px_48px] items-center gap-4 border-b border-[var(--line)] bg-[var(--surface-soft)] px-5 py-3 text-[14px] font-bold text-[var(--muted)] sm:grid\" data-kid=\"1-2-3-3-1\" data-name=\"assignments list table header\">\n                    <span data-kid=\"1-2-3-3-1-1\" data-name=\"assignment name header\">\n                        اسم الواجب\n                    </span>\n                    <span data-kid=\"1-2-3-3-1-2\" data-name=\"assignment date header\">\n                        تاريخ التكليف\n                    </span>\n                    <span data-kid=\"1-2-3-3-1-3\" data-name=\"submission date header\">\n                        تاريخ التقديم\n                    </span>\n                    <span data-kid=\"1-2-3-3-1-4\" data-name=\"status header\">\n                        حالة الإنجاز\n                    </span>\n                    <span aria-hidden=\"true\" data-kid=\"1-2-3-3-1-5\" data-name=\"action header spacer\">\n                    </span>\n                </div>\n                <article class=\"border-b border-[var(--line)]\" data-kid=\"1-2-3-3-2\" data-name=\"expanded assignment item container\">\n                    <button aria-controls=\"assignment-edit-1\" aria-expanded=\"true\" class=\"grid w-full grid-cols-[minmax(0,1fr)_48px] items-center gap-x-3 gap-y-2 px-5 py-4 text-right hover:bg-[var(--paper)] sm:grid-cols-[minmax(0,1fr)_160px_160px_160px_48px] sm:gap-4\" data-kid=\"1-2-3-3-2-1\" data-name=\"assignment item toggle button\" type=\"button\">\n                        <span class=\"min-w-0 text-[16px] font-bold leading-snug text-[var(--ink)]\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"assignment item title text\">\n                            حفظ الآيات الباقية من سورة العلق\n                        </span>\n                        <span class=\"order-2 text-[13px] font-medium text-[var(--muted)] sm:order-none sm:text-[14px]\" data-kid=\"1-2-3-3-2-1-2\" data-name=\"assignment item start date\">\n                            ٢٨ سبتمبر ٢٠٢٦\n                        </span>\n                        <span class=\"order-3 text-[13px] font-medium text-[var(--muted)] sm:order-none sm:text-[14px]\" data-kid=\"1-2-3-3-2-1-3\" data-name=\"assignment item due date\">\n                            ٣٠ سبتمبر ٢٠٢٦\n                        </span>\n                        <span class=\"order-4 inline-flex w-fit items-center rounded-md bg-[var(--late-bg)] px-2.5 py-1 text-[13px] font-bold text-[var(--late-ink)] sm:order-none\" data-kid=\"1-2-3-3-2-1-4\" data-name=\"assignment item status label\">\n                            لم يتم - متأخر\n                        </span>\n                        <span class=\"row-span-4 flex size-10 items-center justify-center rounded-lg text-[var(--wine)] sm:row-span-1\" data-kid=\"1-2-3-3-2-1-5\" data-name=\"toggle chevron container\">\n                            <i aria-hidden=\"true\" class=\"fa-solid fa-chevron-up text-[14px]\" data-kid=\"1-2-3-3-2-1-5-1\" data-name=\"toggle chevron icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <div class=\"border-t border-[var(--line)] bg-[#fffaf1] px-5 py-5\" data-kid=\"1-2-3-3-2-2\" data-name=\"assignment details edit form\" id=\"assignment-edit-1\">\n                        <div class=\"grid gap-x-5 gap-y-4 sm:grid-cols-2 lg:grid-cols-4\" data-kid=\"1-2-3-3-2-2-1\" data-name=\"form fields grid\">\n                            <label class=\"grid gap-2 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-3-3-2-2-1-1\" data-name=\"name edit field container\">\n                                اسم الواجب\n                                <input class=\"min-h-11 w-full rounded-lg border border-[var(--line)] bg-[var(--surface)] px-3 text-[14px] font-medium text-[var(--ink)] outline-none focus:border-[var(--wine)] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-3-3-2-2-1-1-1\" data-name=\"name edit input\" type=\"text\" value=\"حفظ الآيات الباقية من سورة العلق\"/>\n                            </label>\n                            <label class=\"grid gap-2 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-3-3-2-2-1-2\" data-name=\"start date edit field container\">\n                                تاريخ التكليف\n                                <input class=\"min-h-11 w-full rounded-lg border border-[var(--line)] bg-[var(--surface)] px-3 text-[14px] font-medium text-[var(--ink)] outline-none focus:border-[var(--wine)] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-3-3-2-2-1-2-1\" data-name=\"start date edit input\" type=\"date\" value=\"2026-09-28\"/>\n                            </label>\n                            <label class=\"grid gap-2 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-3-3-2-2-1-3\" data-name=\"due date edit field container\">\n                                تاريخ التقديم\n                                <input class=\"min-h-11 w-full rounded-lg border border-[var(--line)] bg-[var(--surface)] px-3 text-[14px] font-medium text-[var(--ink)] outline-none focus:border-[var(--wine)] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-3-3-2-2-1-3-1\" data-name=\"due date edit input\" type=\"date\" value=\"2026-09-30\"/>\n                            </label>\n                            <label class=\"grid gap-2 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-3-3-2-2-1-4\" data-name=\"url edit field container\">\n                                رابط الواجب\n                                <input class=\"min-h-11 w-full rounded-lg border border-[var(--line)] bg-[var(--surface)] px-3 text-[14px] font-medium text-[var(--ink)] outline-none focus:border-[var(--wine)] focus:ring-2 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-3-3-2-2-1-4-1\" data-name=\"url edit input\" type=\"url\" value=\"https://abo-zeyd.github.io/myClass/lessons#islamic-education-surah-al-alaq-item-1d32e32b-image-1\"/>\n                            </label>\n                        </div>\n                        <div class=\"mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--line)] pt-4\" data-kid=\"1-2-3-3-2-2-2\" data-name=\"form footer actions container\">\n                            <label class=\"inline-flex min-h-11 items-center gap-2 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-3-3-2-2-2-1\" data-name=\"completion checkbox container\">\n                                <input class=\"size-5 accent-[#6f1d1b]\" data-kid=\"1-2-3-3-2-2-2-1-1\" data-name=\"completion checkbox\" type=\"checkbox\"/>\n                                تم الإنجاز\n                            </label>\n                            <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-2-3-3-2-2-2-2\" data-name=\"assignment action buttons container\">\n                                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[var(--line)] bg-[var(--surface)] px-4 text-[14px] font-bold text-[var(--ink)] hover:bg-[var(--surface-soft)]\" data-kid=\"1-2-3-3-2-2-2-2-1\" data-name=\"save assignment button\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"fa-regular fa-floppy-disk text-[15px] text-[var(--wine)]\" data-kid=\"1-2-3-3-2-2-2-2-1-1\" data-name=\"save icon\">\n                                    </i>\n                                    حفظ الواجب\n                                </button>\n                                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-[14px] font-bold text-[#8c2e26] hover:bg-[var(--late-bg)]\" data-kid=\"1-2-3-3-2-2-2-2-2\" data-name=\"delete assignment button\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"fa-regular fa-trash-can text-[15px]\" data-kid=\"1-2-3-3-2-2-2-2-2-1\" data-name=\"trash icon\">\n                                    </i>\n                                    حذف الواجب\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n                <article data-kid=\"1-2-3-3-3\" data-name=\"collapsed assignment item container\">\n                    <button aria-controls=\"assignment-edit-2\" aria-expanded=\"false\" class=\"grid w-full grid-cols-[minmax(0,1fr)_48px] items-center gap-x-3 gap-y-2 px-5 py-4 text-right hover:bg-[var(--paper)] sm:grid-cols-[minmax(0,1fr)_160px_160px_160px_48px] sm:gap-4\" data-kid=\"1-2-3-3-3-1\" data-name=\"assignment item toggle button\" type=\"button\">\n                        <span class=\"min-w-0 text-[16px] font-bold leading-snug text-[var(--ink)]\" data-kid=\"1-2-3-3-3-1-1\" data-name=\"assignment item title text\">\n                            حفظ الآيات الثماني الأولى من سورة العلق\n                        </span>\n                        <span class=\"order-2 text-[13px] font-medium text-[var(--muted)] sm:order-none sm:text-[14px]\" data-kid=\"1-2-3-3-3-1-2\" data-name=\"assignment item start date\">\n                            ٢٧ سبتمبر ٢٠٢٦\n                        </span>\n                        <span class=\"order-3 text-[13px] font-medium text-[var(--muted)] sm:order-none sm:text-[14px]\" data-kid=\"1-2-3-3-3-1-3\" data-name=\"assignment item due date\">\n                            ٢٨ سبتمبر ٢٠٢٦\n                        </span>\n                        <span class=\"order-4 inline-flex w-fit items-center rounded-md bg-[var(--late-bg)] px-2.5 py-1 text-[13px] font-bold text-[var(--late-ink)] sm:order-none\" data-kid=\"1-2-3-3-3-1-4\" data-name=\"assignment item status label\">\n                            لم يتم - متأخر\n                        </span>\n                        <span class=\"row-span-4 flex size-10 items-center justify-center rounded-lg text-[var(--muted)] sm:row-span-1\" data-kid=\"1-2-3-3-3-1-5\" data-name=\"toggle chevron container\">\n                            <i aria-hidden=\"true\" class=\"fa-solid fa-chevron-down text-[14px]\" data-kid=\"1-2-3-3-3-1-5-1\" data-name=\"toggle chevron icon\">\n                            </i>\n                        </span>\n                    </button>\n                </article>\n            </div>\n        </section>\n    </main>\n</div>\n",
