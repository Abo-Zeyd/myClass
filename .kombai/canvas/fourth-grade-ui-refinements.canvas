      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[var(--paper)] text-[var(--ink)] [font-family:'Noto_Sans_Arabic',sans-serif]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" style=\"--paper:#fff9ed;--ink:#432818;--surface:#fffdf8;--surface-2:#f8efdc;--line:#e8dbc1;--maroon:#6f1d1b;--brown:#765f4e;--gold:#bb9457;--soft-gold:#f4e9ca;\">\n    <header class=\"border-b border-[var(--line)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1180px] items-center justify-between px-6\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand identity container\">\n                <div class=\"flex size-11 items-center justify-center rounded-xl bg-[var(--soft-gold)] text-[var(--maroon)]\" data-kid=\"1-1-1-1-1\" data-name=\"graduation cap icon wrapper\">\n                    <i class=\"icon-graduation-cap text-[23px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"teacher identification container\">\n                    <div class=\"text-[17px] font-extrabold leading-tight text-[var(--maroon)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"section title\">\n                        قسم السنة الرابعة\n                    </div>\n                    <div class=\"mt-0.5 text-[13px] font-medium text-[var(--brown)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"teacher name\">\n                        الأستاذ عز الدين عويسي\n                    </div>\n                </div>\n            </div>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"flex items-center gap-1 text-[15px] font-semibold\" data-kid=\"1-1-1-2\" data-name=\"main navigation\">\n                <a class=\"flex h-11 items-center gap-2 rounded-lg px-4 text-[var(--brown)]\" data-kid=\"1-1-1-2-1\" data-name=\"home navigation link\" href=\"/\">\n                    <i class=\"icon-house text-[18px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"home icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"home link text\">\n                        الرئيسية\n                    </span>\n                </a>\n                <a aria-current=\"page\" class=\"flex h-11 items-center gap-2 rounded-lg bg-[var(--maroon)] px-4 text-white\" data-kid=\"1-1-1-2-2\" data-name=\"lessons navigation link\" href=\"/lessons\">\n                    <i class=\"icon-book-open text-[18px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"lessons icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"lessons link text\">\n                        الدروس\n                    </span>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1180px] px-6 pb-12 pt-8\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-7 flex flex-wrap items-end justify-between gap-3\" data-kid=\"1-2-1\" data-name=\"main content header\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page headline group\">\n                <h1 class=\"text-[30px] font-extrabold leading-tight tracking-[-0.03em] text-[var(--ink)]\" data-kid=\"1-2-1-1-1\" data-name=\"main page headline\">\n                    الدروس التعليمية\n                </h1>\n                <p class=\"mt-2 text-[15px] leading-7 text-[var(--brown)]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    اختر مادة لعرض الدروس والملخصات والأنشطة المتاحة.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-2 pb-1 text-[13px] font-medium text-[var(--brown)]\" data-kid=\"1-2-1-2\" data-name=\"content section indicator\">\n                <i class=\"icon-book-marked text-[17px] text-[var(--gold)]\" data-kid=\"1-2-1-2-1\" data-name=\"book marked icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"indicator label text\">\n                    محتوى القسم\n                </span>\n            </div>\n        </div>\n        <div class=\"grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_260px]\" data-kid=\"1-2-2\" data-name=\"layout grid container\">\n            <section aria-labelledby=\"subject-title\" class=\"order-last min-w-0 lg:order-first\" data-kid=\"1-2-2-1\" data-name=\"lessons content section\">\n                <div class=\"mb-5 flex items-end justify-between gap-3 border-b border-[var(--line)] pb-4\" data-kid=\"1-2-2-1-1\" data-name=\"subject header\">\n                    <div data-kid=\"1-2-2-1-1-1\" data-name=\"subject title group\">\n                        <h2 class=\"text-[25px] font-extrabold leading-tight text-[var(--maroon)]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"subject title\" id=\"subject-title\">\n                            اللغة العربية\n                        </h2>\n                        <p class=\"mt-1.5 text-[14px] text-[var(--brown)]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"subject description\">\n                            دروس ومحتوى تعليمي للقسم\n                        </p>\n                    </div>\n                    <span class=\"shrink-0 rounded-full bg-[var(--soft-gold)] px-3 py-1.5 text-[13px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-1-2\" data-name=\"lesson count badge\">\n                        31 درسًا\n                    </span>\n                </div>\n                <div class=\"border-b border-[var(--line)]\" data-kid=\"1-2-2-1-2\" data-name=\"lesson accordion category\">\n                    <div class=\"flex min-h-12 items-center justify-between gap-4 bg-[var(--surface-2)] px-4 py-3\" data-kid=\"1-2-2-1-2-1\" data-name=\"accordion header\">\n                        <h3 class=\"flex items-center gap-2 text-[17px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"accordion toggle title\">\n                            <i class=\"icon-chevron-down text-[17px] text-[var(--maroon)]\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"accordion chevron icon\">\n                            </i>\n                            تقويم تشخيصي\n                        </h3>\n                        <span class=\"text-[13px] font-medium text-[var(--brown)]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"lesson count text\">\n                            درسان\n                        </span>\n                    </div>\n                    <div class=\"px-4 pb-4 pt-2\" data-kid=\"1-2-2-1-2-2\" data-name=\"accordion content\">\n                        <article class=\"border-b border-[var(--line)] py-3\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"lesson article\">\n                            <h4 class=\"text-[17px] font-bold text-[var(--maroon)]\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"lesson title\">\n                                القراءة والفهم\n                            </h4>\n                            <section class=\"mt-3 border-r-2 border-[var(--gold)] pr-4\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"lesson summary section\">\n                                <h5 class=\"text-[14px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"summary heading\">\n                                    الخلاصة\n                                </h5>\n                                <p class=\"mt-1.5 max-w-[62ch] text-[14px] leading-7 text-[var(--ink)]\" data-kid=\"1-2-2-1-2-2-1-2-2\" data-name=\"summary content\">\n                                    تساعد القراءة المتأنية على فهم النص واستخراج فكرته العامة وتفاصيله المهمة.\n                                </p>\n                            </section>\n                            <section class=\"mt-3 border-r-2 border-[var(--line)] pr-4\" data-kid=\"1-2-2-1-2-2-1-3\" data-name=\"lesson activities section\">\n                                <h5 class=\"text-[14px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-2-2-1-3-1\" data-name=\"activities heading\">\n                                    أنشطة وتمارين\n                                </h5>\n                                <ol class=\"mt-1.5 list-inside list-decimal space-y-1 text-[14px] leading-6 text-[var(--ink)]\" data-kid=\"1-2-2-1-2-2-1-3-2\" data-name=\"activity list\">\n                                    <li data-kid=\"1-2-2-1-2-2-1-3-2-1\" data-name=\"activity step 1\">\n                                        اقرأ نصاً قصيراً بصوت واضح، ثم اذكر فكرته العامة.\n                                    </li>\n                                    <li data-kid=\"1-2-2-1-2-2-1-3-2-2\" data-name=\"activity step 2\">\n                                        استخرج من النص كلمة تدل على المكان، واشرح معناها من السياق.\n                                    </li>\n                                </ol>\n                            </section>\n                            <div class=\"mt-4 flex flex-wrap items-center gap-3 border-t border-[var(--line)] pt-3\" data-kid=\"1-2-2-1-2-2-1-4\" data-name=\"lesson resources bar\">\n                                <div class=\"flex items-center gap-2 text-[13px] font-bold text-[var(--brown)]\" data-kid=\"1-2-2-1-2-2-1-4-1\" data-name=\"resources label\">\n                                    <i class=\"icon-paperclip text-[16px] text-[var(--gold)]\" data-kid=\"1-2-2-1-2-2-1-4-1-1\" data-name=\"paperclip icon\">\n                                    </i>\n                                    الموارد\n                                </div>\n                                <a class=\"inline-flex min-h-10 items-center gap-2 rounded-lg border border-[var(--line)] bg-[var(--surface)] px-3 text-[13px] font-semibold text-[var(--maroon)]\" data-kid=\"1-2-2-1-2-2-1-4-2\" data-name=\"image resource link\" href=\"#arabic-arabic-01-arabic-01-reading-image-0\">\n                                    <i class=\"icon-image text-[17px]\" data-kid=\"1-2-2-1-2-2-1-4-2-1\" data-name=\"image icon\">\n                                    </i>\n                                    صورة القراءة\n                                </a>\n                                <a class=\"inline-flex min-h-10 items-center gap-2 rounded-lg border border-[var(--line)] bg-[var(--surface)] px-3 text-[13px] font-semibold text-[var(--maroon)]\" data-kid=\"1-2-2-1-2-2-1-4-3\" data-name=\"video resource link\" href=\"#arabic-arabic-01-arabic-01-reading-video-0\">\n                                    <i class=\"icon-circle-play text-[17px]\" data-kid=\"1-2-2-1-2-2-1-4-3-1\" data-name=\"video play icon\">\n                                    </i>\n                                    فيديو القراءة والفهم\n                                </a>\n                            </div>\n                        </article>\n                        <article class=\"flex items-center justify-between gap-4 py-3\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"lesson list item\">\n                            <div data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"lesson item header\">\n                                <h4 class=\"text-[16px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-2-2-2-1-1\" data-name=\"lesson title\">\n                                    التعبير الكتابي\n                                </h4>\n                                <p class=\"mt-1 text-[13px] leading-6 text-[var(--brown)]\" data-kid=\"1-2-2-1-2-2-2-1-2\" data-name=\"lesson subtitle\">\n                                    فقرة مترابطة، فكرة واضحة، وعلامة ترقيم مناسبة.\n                                </p>\n                            </div>\n                            <button aria-expanded=\"false\" aria-label=\"فتح التعبير الكتابي\" class=\"flex size-10 shrink-0 items-center justify-center rounded-full text-[var(--maroon)]\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"lesson expand button\" type=\"button\">\n                                <i class=\"icon-plus text-[19px]\" data-kid=\"1-2-2-1-2-2-2-2-1\" data-name=\"plus icon\">\n                                </i>\n                            </button>\n                        </article>\n                    </div>\n                </div>\n                <div class=\"border-b border-[var(--line)]\" data-kid=\"1-2-2-1-3\" data-name=\"lesson accordion entry 2\">\n                    <div class=\"flex min-h-[58px] items-center justify-between gap-4 px-4 py-3\" data-kid=\"1-2-2-1-3-1\" data-name=\"accordion header\">\n                        <h3 class=\"text-[16px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"accordion title\">\n                            مع عصاي في المدرسة\n                        </h3>\n                        <button aria-expanded=\"false\" aria-label=\"فتح درس مع عصاي في المدرسة\" class=\"flex size-10 shrink-0 items-center justify-center rounded-full text-[var(--brown)]\" data-kid=\"1-2-2-1-3-1-2\" data-name=\"accordion toggle button\" type=\"button\">\n                            <i class=\"icon-chevron-down text-[17px]\" data-kid=\"1-2-2-1-3-1-2-1\" data-name=\"chevron icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"border-b border-[var(--line)]\" data-kid=\"1-2-2-1-4\" data-name=\"lesson accordion entry 3\">\n                    <div class=\"flex min-h-[58px] items-center justify-between gap-4 px-4 py-3\" data-kid=\"1-2-2-1-4-1\" data-name=\"accordion header\">\n                        <h3 class=\"text-[16px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"accordion title\">\n                            ماسح الزجاج\n                        </h3>\n                        <button aria-expanded=\"false\" aria-label=\"فتح درس ماسح الزجاج\" class=\"flex size-10 shrink-0 items-center justify-center rounded-full text-[var(--brown)]\" data-kid=\"1-2-2-1-4-1-2\" data-name=\"accordion toggle button\" type=\"button\">\n                            <i class=\"icon-chevron-down text-[17px]\" data-kid=\"1-2-2-1-4-1-2-1\" data-name=\"chevron icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <p class=\"pt-4 text-[13px] leading-6 text-[var(--brown)]\" data-kid=\"1-2-2-1-5\" data-name=\"lesson ordering hint\">\n                    تظهر الدروس حسب ترتيبها في محتوى المادة.\n                </p>\n            </section>\n            <aside aria-label=\"مواد السنة الرابعة\" class=\"border-t-[3px] border-[var(--maroon)] bg-[var(--surface)] px-4 pb-3 pt-3 lg:sticky lg:top-5\" data-kid=\"1-2-2-2\" data-name=\"sidebar navigation\">\n                <h2 class=\"mb-2 text-[16px] font-extrabold text-[var(--ink)]\" data-kid=\"1-2-2-2-1\" data-name=\"sidebar heading\">\n                    مواد السنة الرابعة\n                </h2>\n                <ul class=\"divide-y divide-[var(--line)]\" data-kid=\"1-2-2-2-2\" data-name=\"subjects list\">\n                    <li data-kid=\"1-2-2-2-2-1\" data-name=\"subjects list item 1\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 px-2 text-right text-[14px] font-medium text-[var(--ink)]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"subject button\" type=\"button\">\n                            <i class=\"icon-book-marked text-[17px] text-[var(--brown)]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"book marked icon\">\n                            </i>\n                            التربية الإسلامية\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-2-2-2-2\" data-name=\"subjects list item 2\">\n                        <button aria-pressed=\"true\" class=\"flex min-h-11 w-full items-center gap-3 border-r-[3px] border-[var(--maroon)] bg-[var(--surface-2)] px-2 text-right text-[14px] font-bold text-[var(--maroon)]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"active subject button\" type=\"button\">\n                            <i class=\"icon-book-open text-[17px]\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"book open icon\">\n                            </i>\n                            اللغة العربية\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-2-2-2-3\" data-name=\"subjects list item 3\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 px-2 text-right text-[14px] font-medium text-[var(--ink)]\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"subject button\" type=\"button\">\n                            <i class=\"icon-calculator text-[17px] text-[var(--brown)]\" data-kid=\"1-2-2-2-2-3-1-1\" data-name=\"calculator icon\">\n                            </i>\n                            الرياضيات\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-2-2-2-4\" data-name=\"subjects list item 4\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 px-2 text-right text-[14px] font-medium text-[var(--ink)]\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"subject button\" type=\"button\">\n                            <i class=\"icon-history text-[17px] text-[var(--brown)]\" data-kid=\"1-2-2-2-2-4-1-1\" data-name=\"history icon\">\n                            </i>\n                            التاريخ\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-2-2-2-5\" data-name=\"subjects list item 5\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 px-2 text-right text-[14px] font-medium text-[var(--ink)]\" data-kid=\"1-2-2-2-2-5-1\" data-name=\"subject button\" type=\"button\">\n                            <i class=\"icon-map text-[17px] text-[var(--brown)]\" data-kid=\"1-2-2-2-2-5-1-1\" data-name=\"map icon\">\n                            </i>\n                            الجغرافيا\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-2-2-2-6\" data-name=\"subjects list item 6\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 px-2 text-right text-[14px] font-medium text-[var(--ink)]\" data-kid=\"1-2-2-2-2-6-1\" data-name=\"subject button\" type=\"button\">\n                            <i class=\"icon-scale text-[17px] text-[var(--brown)]\" data-kid=\"1-2-2-2-2-6-1-1\" data-name=\"scale icon\">\n                            </i>\n                            التربية المدنية\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-2-2-2-7\" data-name=\"subjects list item 7\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 px-2 text-right text-[14px] font-medium text-[var(--ink)]\" data-kid=\"1-2-2-2-2-7-1\" data-name=\"subject button\" type=\"button\">\n                            <i class=\"icon-flask-conical text-[17px] text-[var(--brown)]\" data-kid=\"1-2-2-2-2-7-1-1\" data-name=\"flask conical icon\">\n                            </i>\n                            التربية العلمية\n                        </button>\n                    </li>\n                    <li data-kid=\"1-2-2-2-2-8\" data-name=\"subjects list item 8\">\n                        <button aria-pressed=\"false\" class=\"flex min-h-11 w-full items-center gap-3 px-2 text-right text-[14px] font-medium text-[var(--ink)]\" data-kid=\"1-2-2-2-2-8-1\" data-name=\"subject button\" type=\"button\">\n                            <i class=\"icon-scroll-text text-[17px] text-[var(--brown)]\" data-kid=\"1-2-2-2-2-8-1-1\" data-name=\"scroll text icon\">\n                            </i>\n                            المحفوظات\n                        </button>\n                    </li>\n                </ul>\n            </aside>\n        </div>\n    </main>\n    <footer class=\"border-t border-[var(--line)] bg-[var(--surface)]\" data-kid=\"1-3\" data-name=\"page footer\">\n        <div class=\"mx-auto max-w-[1180px] px-6 py-4 text-[13px] text-[var(--brown)]\" data-kid=\"1-3-1\" data-name=\"footer text content\">\n            قسم السنة الرابعة · الأستاذ عز الدين عويسي\n        </div>\n    </footer>\n</div>\n",
