      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[var(--background)] text-[var(--foreground)] [--background:#fff9ed] [--foreground:#432818] [--surface:#fffdf8] [--surface-muted:#ffe6a7] [--border:#ead9b5] [--primary:#6f1d1b] [--secondary:#bb9457] [--muted-foreground:#765f4e]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Noto Sans Arabic',sans-serif;\">\n    <header class=\"border-b border-[var(--border)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"header navigation container\">\n        <div class=\"mx-auto flex h-[76px] max-w-6xl items-center justify-between px-5 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header layout wrapper\">\n            <a class=\"flex items-center gap-3 no-underline text-[var(--foreground)]\" data-kid=\"1-1-1-1\" data-name=\"site logo and name link\" href=\"/\">\n                <span class=\"flex size-11 items-center justify-center rounded-2xl bg-[#f4ebe0] text-[22px] text-[var(--primary)]\" data-kid=\"1-1-1-1-1\" data-name=\"site icon container\">\n                    <i aria-hidden=\"true\" class=\"icon-graduation-cap\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon\">\n                    </i>\n                </span>\n                <span class=\"flex flex-col leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"site name text group\">\n                    <span class=\"text-[17px] font-extrabold text-[var(--primary)] sm:text-[19px]\" data-kid=\"1-1-1-1-2-1\" data-name=\"site name heading\">\n                        قسم السنة الرابعة\n                    </span>\n                    <span class=\"mt-1 text-[13px] font-medium text-[var(--muted-foreground)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"site instructor name text\">\n                        الأستاذ: عز الدين عويسي\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"flex items-center gap-1.5 text-[14px] font-semibold sm:gap-3 sm:text-[15px]\" data-kid=\"1-1-1-2\" data-name=\"main navigation list\">\n                <a class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-[var(--foreground)] hover:bg-[#f8f0e5] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]\" data-kid=\"1-1-1-2-1\" data-name=\"home page link\" href=\"/\">\n                    <i aria-hidden=\"true\" class=\"icon-house text-[18px] text-[var(--primary)]\" data-kid=\"1-1-1-2-1-1\" data-name=\"home icon\">\n                    </i>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-1-1-2-1-2\" data-name=\"home link text\">\n                        الرئيسية\n                    </span>\n                </a>\n                <a class=\"inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-[var(--foreground)] hover:bg-[#f8f0e5] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]\" data-kid=\"1-1-1-2-2\" data-name=\"lessons page link\" href=\"/lessons\">\n                    <i aria-hidden=\"true\" class=\"icon-book-open text-[18px] text-[var(--primary)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"lessons book icon\">\n                    </i>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-1-1-2-2-2\" data-name=\"lessons link text\">\n                        الدروس\n                    </span>\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto flex min-h-[calc(100vh-76px)] max-w-6xl items-center justify-center px-5 py-12 sm:px-8\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"admin-heading\" class=\"w-full max-w-[480px] rounded-2xl border border-[var(--border)] bg-[var(--surface)] px-6 py-8 sm:px-10 sm:py-10\" data-kid=\"1-2-1\" data-name=\"admin login card\">\n            <div class=\"mb-8\" data-kid=\"1-2-1-1\" data-name=\"card header text area\">\n                <h1 class=\"text-[28px] font-extrabold leading-[1.35] tracking-tight text-[var(--foreground)] sm:text-[32px]\" data-kid=\"1-2-1-1-1\" data-name=\"login page title\" id=\"admin-heading\">\n                    دخول لوحة الإدارة\n                </h1>\n                <p class=\"mt-2 text-[16px] leading-7 text-[var(--muted-foreground)]\" data-kid=\"1-2-1-1-2\" data-name=\"login page description\">\n                    إدارة الواجبات ومحتوى الدروس\n                </p>\n            </div>\n            <p class=\"mb-5 rounded-lg border border-[#d8aaa2] bg-[#fbefed] px-4 py-3 text-[14px] font-medium leading-6 text-[#7b2924]\" data-dynamic=\"true\" data-kid=\"1-2-1-2\" data-name=\"error alert message\" data-reason=\"error text dynamically displayed by script\" role=\"alert\">\n                كلمة المرور غير صحيحة.\n            </p>\n            <form aria-label=\"تسجيل دخول الإدارة\" class=\"grid gap-5\" data-kid=\"1-2-1-3\" data-name=\"login form\">\n                <label class=\"grid gap-2 text-[15px] font-bold text-[var(--foreground)]\" data-kid=\"1-2-1-3-1\" data-name=\"password field label\" for=\"admin-password\">\n                    كلمة المرور\n                    <input autocomplete=\"current-password\" class=\"min-h-[52px] w-full rounded-lg border border-[var(--border)] bg-[var(--background)] px-4 text-[17px] text-[var(--foreground)] outline-none transition-colors placeholder:text-[var(--muted-foreground)] focus:border-[var(--primary)] focus:ring-3 focus:ring-[#6f1d1b]/15\" data-kid=\"1-2-1-3-1-1\" data-name=\"password input field\" id=\"admin-password\" name=\"password\" required=\"\" type=\"password\"/>\n                </label>\n                <button class=\"mt-1 inline-flex min-h-[52px] w-full items-center justify-center rounded-lg bg-[var(--primary)] px-5 text-[16px] font-bold text-white hover:bg-[#581715] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--primary)] active:translate-y-px\" data-kid=\"1-2-1-3-2\" data-name=\"login submission button\" type=\"button\">\n                    تسجيل الدخول\n                </button>\n            </form>\n        </section>\n    </main>\n</div>\n",
